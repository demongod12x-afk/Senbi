		minRate = 10,
		baseSize = baseSize,
		baseSpeedMin = cfg.speedMin * 1.25,
		baseSpeedMax = cfg.speedMax * 1.35,
		baseSpread = cfg.spread * 0.8,
		baseRotSpeed = 58,
		baseAccel = baseAccel,
	}
end

local function scaleAuraNumberSeq(seq, mult, minClamp, maxClamp)
	local kps = {}
	for _, kp in ipairs(seq.Keypoints) do
		local val = kp.Value * mult
		if minClamp or maxClamp then
			val = math.clamp(val, minClamp or -math.huge, maxClamp or math.huge)
		end
		table.insert(kps, NumberSequenceKeypoint.new(kp.Time, val))
	end
	return NumberSequence.new(kps)
end

local function buildAura(char, hrp)
	if not char or not hrp then return end
	local modeName = AURA_MODES[Cfg.AuraModeIdx] or "COLUMN"
	local lvl = math.clamp(tonumber(Cfg.AuraLevel) or 1, 1, MAX_AURA_LEVEL)
	local isUltimate = (Cfg.UltimateSpread == true)
	clearAuraEffects()
	builtAuraMode = modeName
	builtAuraLevel = lvl
	builtAuraUltimate = isUltimate
	builtAuraChar = char
	builtAuraColorSig = getAuraColorSignature()

	local activeSet = buildAuraColorSet(modeName)
	local emitters = {}
	local spreadEmitters = {}
	local extras = {}
	local ptLight = nil

	if modeName == "SMOKE" then
		local preset = isUltimate and ULTIMATE_SPREAD_PRESET or (SMOKE_PRESETS[lvl] or SMOKE_PRESETS[1])
		local parts = getAuraTargetParts(char)
		local smokeSeq = makeAuraSequence("SMOKE")
		if isUltimate then
			applyAuraUltimateGlow(char, "SMOKE", extras)
			attachAuraUltimateSpread(char, "SMOKE", SURGE_TEXTURES, spreadEmitters)
		end
		local offsets = isUltimate and {
			Vector3.new(-0.55, 0.35, 0),
			Vector3.new(0.55, -0.25, 0),
			Vector3.new(0, 0.25, 0.55),
			Vector3.new(0, -0.35, -0.55),
		} or {
			Vector3.new(-0.32, 0.25, 0),
			Vector3.new(0.32, -0.25, 0),
			Vector3.new(0, 0, 0.32),
			Vector3.new(0, -0.35, 0),
		}
		local minAuraRate = isUltimate and 40 or ((lvl == 1) and 10 or ((lvl == 2) and 28 or 42))
		local maxAuraRate = isUltimate and 16000 or 1200
		local maxShardRate = isUltimate and 11000 or 900
		local maxSurgeRate = isUltimate and 13000 or 1000

		for _, part in ipairs(parts) do
			local legBoost = (isAuraLegOrFoot(part) and (isUltimate or lvl >= 3)) and 1.35 or ((isAuraLegOrFoot(part) and lvl == 2) and 1.15 or 1.0)
			for i = 1, 4 do
				local att = Instance.new("Attachment")
				att.Name = "MortalAuraAtt_" .. tostring(i)
				att.Position = offsets[i] or Vector3.zero
				markAuraOwned(att, "MortalSmokeAtt")
				att.Parent = part
				table.insert(activeAuraAttachments, att)

				local aura = Instance.new("ParticleEmitter")
				aura.Name = "MortalDarkNeonAura"
				markAuraOwned(aura, "MortalSmokeAura")
				aura.Parent = att
				aura.Color = smokeSeq
				aura.Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, math.clamp(0.80 * preset.sizeMult * legBoost, 0.1, 40)),
					NumberSequenceKeypoint.new(0.55, math.clamp(1.85 * preset.sizeMult * legBoost, 0.2, 78)),
					NumberSequenceKeypoint.new(1, math.clamp(0.15 * (isUltimate and 18 or 1), 0.1, 18)),
				})
				aura.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, isUltimate and 0.50 or ((lvl == 1) and 0.35 or ((lvl == 2) and 0.24 or 0.14))),
					NumberSequenceKeypoint.new(0.55, isUltimate and 0.66 or ((lvl == 1) and 0.65 or ((lvl == 2) and 0.52 or 0.38))),
					NumberSequenceKeypoint.new(1, 1),
				})
				aura.Lifetime = NumberRange.new((not isUltimate and lvl == 1) and 0.45 or 0.75, (not isUltimate and lvl == 1) and 0.75 or (isUltimate and 1.5 or 1.25))
				aura.Rate = math.clamp(34 * preset.rateMult * legBoost, minAuraRate, maxAuraRate)
				aura.Speed = NumberRange.new(math.clamp(2.8 * preset.speedMult, 0.5, 220), math.clamp(7.2 * preset.speedMult, 1.0, 320))
				aura.SpreadAngle = Vector2.new(360, 360)
				aura.Rotation = NumberRange.new(-180, 180)
				aura.RotSpeed = NumberRange.new(-180 * (isUltimate and 4 or 1), 180 * (isUltimate and 4 or 1))
				aura.LightEmission = 0
				aura.LightInfluence = 0.25
				aura.Enabled = true
				table.insert(activeAuraEmitters, aura)
				table.insert(emitters, aura)

				if preset.shards then
					local shards = Instance.new("ParticleEmitter")
					shards.Name = "MortalDarkNeonShards"
					markAuraOwned(shards, "MortalSmokeAura")
					shards.Parent = att
					shards.Color = smokeSeq
					shards.Size = NumberSequence.new({
						NumberSequenceKeypoint.new(0, math.clamp(0.34 * preset.sizeMult * legBoost, 0.05, 28)),
						NumberSequenceKeypoint.new(1, 0),
					})
					shards.Transparency = NumberSequence.new({
						NumberSequenceKeypoint.new(0, isUltimate and 0.42 or ((lvl == 1) and 0.25 or 0.08)),
						NumberSequenceKeypoint.new(1, 1),
					})
					shards.Lifetime = NumberRange.new((not isUltimate and lvl == 1) and 0.3 or 0.5, (not isUltimate and lvl == 1) and 0.55 or 0.95)
					shards.Rate = math.clamp(22 * preset.rateMult * legBoost, (not isUltimate and lvl == 1) and 8 or ((not isUltimate and lvl == 2) and 22 or 35), maxShardRate)
					shards.Speed = NumberRange.new(math.clamp(5.0 * preset.speedMult, 1.0, 260), math.clamp(12.0 * preset.speedMult, 2.0, 400))
					shards.SpreadAngle = Vector2.new(360, 360)
					shards.LightEmission = 0
					shards.LightInfluence = 0.25
					shards.Enabled = true
					table.insert(activeAuraEmitters, shards)
					table.insert(emitters, shards)
				end

				if preset.surge then
					local surge = Instance.new("ParticleEmitter")
					surge.Name = "MortalDarkNeonSurge"
					markAuraOwned(surge, "MortalSmokeAura")
					surge.Parent = att
					surge.Color = smokeSeq
					surge.Size = NumberSequence.new({
						NumberSequenceKeypoint.new(0, math.clamp(1.2 * preset.sizeMult * legBoost, 0.2, 58)),
						NumberSequenceKeypoint.new(0.7, math.clamp(2.65 * preset.sizeMult * legBoost, 0.4, 92)),
						NumberSequenceKeypoint.new(1, math.clamp(0.15 * (isUltimate and 18 or 1), 0.1, 22)),
					})
					surge.Transparency = NumberSequence.new({
						NumberSequenceKeypoint.new(0, isUltimate and 0.50 or 0.2),
						NumberSequenceKeypoint.new(1, 1),
					})
					surge.Lifetime = NumberRange.new(0.6, isUltimate and 1.35 or 1.05)
					surge.Rate = math.clamp(28 * preset.rateMult * legBoost, 45, maxSurgeRate)
					surge.Speed = NumberRange.new(math.clamp(3.5 * preset.speedMult, 1.0, 240), math.clamp(9.0 * preset.speedMult, 2.0, 360))
					surge.SpreadAngle = Vector2.new(360, 360)
					surge.RotSpeed = NumberRange.new(-240 * (isUltimate and 4 or 1), 240 * (isUltimate and 4 or 1))
					surge.LightEmission = 0
					surge.LightInfluence = 0.25
					surge.Enabled = true
					table.insert(activeAuraEmitters, surge)
					table.insert(emitters, surge)
				end
			end
		end
	elseif modeName == "COLUMN" then
		local cfg = COLUMN_CONFIG[lvl] or COLUMN_CONFIG[1]
		local bodyParts = collectAuraBodyParts(char, hrp)
		for idx, bp in ipairs(bodyParts) do
			local texIdx = ((idx - 1) % 2) + 1
			local e1 = createColumnEmitterEntry(bp, cfg, #bodyParts, true, texIdx)
			local e2 = createColumnEmitterEntry(bp, cfg, #bodyParts, false, texIdx)
			local e3 = createColumnSparkEntry(bp, cfg, #bodyParts)
			table.insert(emitters, e1)
			table.insert(emitters, e2)
			table.insert(emitters, e3)
			table.insert(activeAuraEmitters, e1)
			table.insert(activeAuraEmitters, e2)
			table.insert(activeAuraEmitters, e3)
		end
		ptLight = Instance.new("PointLight")
		markAuraOwned(ptLight, "MortalColumnAura")
		ptLight.Color = activeSet.Light
		ptLight.Brightness = cfg.lightBright
		ptLight.Range = cfg.lightRange
		ptLight.Parent = hrp
		if isUltimate then
			applyAuraUltimateGlow(char, "COLUMN", extras)
			attachAuraUltimateSpread(char, "COLUMN", COLUMN_TEXTURES, spreadEmitters)
		end
	else
		local cfg = SURGE_CONFIG[lvl] or SURGE_CONFIG[1]
		local bodyParts = collectAuraBodyParts(char, hrp)
		for idx, bp in ipairs(bodyParts) do
			local texIdx = ((idx - 1) % #SURGE_TEXTURES) + 1
			local c1 = createSurgeCloudEntry(bp, cfg, #bodyParts, false, texIdx)
			local c2 = createSurgeCloudEntry(bp, cfg, #bodyParts, true, texIdx)
			local w1 = createSurgeWispEntry(bp, cfg, #bodyParts, texIdx)
			table.insert(emitters, c1)
			table.insert(emitters, c2)
			table.insert(emitters, w1)
			table.insert(activeAuraEmitters, c1)
			table.insert(activeAuraEmitters, c2)
			table.insert(activeAuraEmitters, w1)
		end
		ptLight = Instance.new("PointLight")
		markAuraOwned(ptLight, "MortalSurgeAura")
		ptLight.Color = activeSet.Light
		ptLight.Brightness = cfg.lightBright
		ptLight.Range = cfg.lightRange
		ptLight.Parent = hrp
		if isUltimate then
			applyAuraUltimateGlow(char, "SURGE", extras)
			attachAuraUltimateSpread(char, "SURGE", SURGE_TEXTURES, spreadEmitters)
		end
	end

	table.insert(activeAuraItems, {
		mode = modeName,
		emitters = emitters,
		spreadEmitters = spreadEmitters,
		extras = extras,
		light = ptLight,
	})
end

local function stepAura(now, char, hum, hrp)
	local modeName = AURA_MODES[Cfg.AuraModeIdx] or "COLUMN"
	local lvl = math.clamp(tonumber(Cfg.AuraLevel) or 1, 1, MAX_AURA_LEVEL)
	local isUltimate = (Cfg.UltimateSpread == true)
	local colorSig = getAuraColorSignature()

	if not Cfg.AuraEnabled or not char or not hum or hum.Health <= 0 or not hrp then
		if builtAuraMode ~= nil or #activeAuraEmitters > 0 then
			clearAuraEffects()
		end
		return
	end

	if builtAuraChar ~= char or builtAuraMode ~= modeName or builtAuraLevel ~= lvl or builtAuraUltimate ~= isUltimate then
		buildAura(char, hrp)
	elseif builtAuraColorSig ~= colorSig then
		applyLiveAuraColorOnly()
	end

	if modeName == "SMOKE" then
		return
	end

	local horizVel = Vector3.new(hrp.AssemblyLinearVelocity.X, 0, hrp.AssemblyLinearVelocity.Z)
	local isIdle = horizVel.Magnitude <= 1.2
	local activeSeq = makeAuraSequence(modeName)

	for _, item in ipairs(activeAuraItems) do
		if modeName == "SURGE" then
			local cfg = SURGE_CONFIG[lvl] or SURGE_CONFIG[1]
			local moveFactor = math.clamp(horizVel.Magnitude / 16, 0, 2.5)
			local rateBoost = isIdle and cfg.idleMult or (1 + (moveFactor * 1.35))
			local sizeBoost = isIdle and 1.12 or (1 + (moveFactor * 0.22))
			local burstTick = math.floor(now * 14)
			local shouldBurst = (not isUltimate) and (not isIdle) and (moveFactor > 0.15) and (burstTick ~= lastSurgeBurstTick)
			if shouldBurst then
				lastSurgeBurstTick = burstTick
			end
			for _, entry in ipairs(item.emitters or {}) do
				local pe = entry.emitter
				if pe and pe.Parent and entry.baseRate then
					pe.Enabled = true
					pe.Color = activeSeq
					pe.LightEmission = 0
					pe.LightInfluence = 0.35
					if isUltimate then
						pe.Rate = math.clamp(entry.baseRate * ULTIMATE_SPREAD_PRESET.rateMult, 40, 16000)
						pe.Size = scaleAuraNumberSeq(entry.baseSize, ULTIMATE_SPREAD_PRESET.sizeMult, 0.2, 78)
						pe.Speed = NumberRange.new(
							math.clamp(entry.baseSpeedMin * ULTIMATE_SPREAD_PRESET.speedMult, 1.2, 240),
							math.clamp(entry.baseSpeedMax * ULTIMATE_SPREAD_PRESET.speedMult, 2.5, 350)
						)
						pe.Transparency = NumberSequence.new({
							NumberSequenceKeypoint.new(0, 0.28),
							NumberSequenceKeypoint.new(0.55, 0.46),
							NumberSequenceKeypoint.new(1, 1),
						})
						pe.SpreadAngle = Vector2.new(360, 360)
						pe.Drag = 1.0
						pe.RotSpeed = NumberRange.new(-360, 360)
						pe.Acceleration = Vector3.new(0, 14, 0)
					else
						pe.Rate = math.max(entry.minRate or 10, math.floor(entry.baseRate * rateBoost))
						pe.Size = scaleAuraNumberSeq(entry.baseSize, sizeBoost)
						pe.Speed = NumberRange.new(entry.baseSpeedMin, entry.baseSpeedMax)
						pe.SpreadAngle = Vector2.new(entry.baseSpread, entry.baseSpread)
						pe.RotSpeed = NumberRange.new(-entry.baseRotSpeed, entry.baseRotSpeed)
						if shouldBurst then
							local counterDrag = -horizVel * 0.45
							pe.Acceleration = Vector3.new(entry.baseAccel.X + counterDrag.X, entry.baseAccel.Y, entry.baseAccel.Z + counterDrag.Z)
							pe:Emit(entry.kind == "cloud" and 2 or 1)
						else
							pe.Acceleration = entry.baseAccel
						end
					end
				end
			end
			if item.light and item.light.Parent then
				item.light.Range = cfg.lightRange
				item.light.Brightness = cfg.lightBright + math.sin(now * 4.5) * 0.25
			end
		elseif modeName == "COLUMN" then
			local cfg = COLUMN_CONFIG[lvl] or COLUMN_CONFIG[1]
			for _, entry in ipairs(item.emitters or {}) do
				local pe = entry.emitter
				if pe and pe.Parent and entry.baseRate then
					pe.Enabled = true
					pe.Color = activeSeq
					if isUltimate then
						pe.LightEmission = 0
						pe.LightInfluence = 0.25
						pe.Rate = math.clamp(entry.baseRate * ULTIMATE_SPREAD_PRESET.rateMult, 50, 16000)
						pe.Size = scaleAuraNumberSeq(entry.baseSize, ULTIMATE_SPREAD_PRESET.sizeMult, 0.2, 85)
						pe.Speed = NumberRange.new(
							math.clamp(entry.baseSpeedMin * ULTIMATE_SPREAD_PRESET.speedMult, 1.5, 280),
							math.clamp(entry.baseSpeedMax * ULTIMATE_SPREAD_PRESET.speedMult, 3, 400)
						)
						pe.Transparency = NumberSequence.new({
							NumberSequenceKeypoint.new(0, 0.24),
							NumberSequenceKeypoint.new(0.55, 0.40),
							NumberSequenceKeypoint.new(1, 1),
						})
						pe.SpreadAngle = Vector2.new(195, 195)
						pe.Drag = 2.4
						pe.RotSpeed = NumberRange.new(-140, 140)
						pe.Acceleration = Vector3.new(0, 65, 0)
					else
						pe.LightInfluence = 0.25
						pe.Rate = math.max(entry.minRate or 24, entry.baseRate)
						pe.Size = entry.baseSize
						pe.Speed = NumberRange.new(entry.baseSpeedMin, entry.baseSpeedMax)
						pe.SpreadAngle = Vector2.new(entry.baseSpread, entry.baseSpread)
						pe.RotSpeed = NumberRange.new(-entry.baseRotSpeed, entry.baseRotSpeed)
					end
				end
			end
			if item.light and item.light.Parent then
				item.light.Range = cfg.lightRange
				item.light.Brightness = cfg.lightBright + math.sin(now * 4.5) * 0.25
			end
		end
	end
end

