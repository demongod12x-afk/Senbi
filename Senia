local function syncAllESP()
	local targetPlr = getActiveTargetPlayer()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local isTgt = (targetPlr == plr) or (targetEspSet[plr] == true)
			local isFrd = (friendEspSet[plr] == true)
			local isAll = (Cfg.ESPAll == true)
			if isTgt then
				drawESP(plr, Color3.fromRGB(255, 25, 25), Color3.fromRGB(255, 235, 30), "TARGET")
			elseif isFrd then
				drawESP(plr, Color3.fromRGB(30, 110, 255), Color3.fromRGB(155, 88, 35), "FRIEND")
			elseif isAll then
				drawESP(plr, Color3.fromRGB(145, 25, 255), Color3.fromRGB(45, 245, 95), "ALL")
			else
				clearESP(plr)
			end
		end
	end
end

