local function getTier()
	local lvl = math.clamp(math.floor(parseSafeNumber(State.AuraLevel, 1, 1, 5)), 1, 5)
	State.AuraLevel = lvl
	return LEVEL_TIERS[lvl]
end

function AuraSystem.Clear()
	for _, item in ipairs(activeAuraItems) do
		if item.emitters then
			for _, pe in ipairs(item.emitters) do
				pcall(function()
					pe.Enabled = false
					pe:Clear()
					pe:Destroy()
				end)
			end
		end
		if item.light then
			pcall(function()
				item.light.Enabled = false
				item.light:Destroy()
			end)
		end
	end
	table.clear(activeAuraItems)

	if LocalPlayer.Character then
		for _, desc in ipairs(LocalPlayer.Character:GetDescendants()) do
			if desc:GetAttribute("SeniaAuraFX") or desc:GetAttribute("MortalAuraFX") then
				pcall(function() desc:Destroy() end)
			end
		end
	end

	if auraFolder then
		pcall(function() auraFolder:Destroy() end)
		auraFolder = nil
	end
	if crackRootFolder then
		pcall(function() crackRootFolder:Destroy() end)
		crackRootFolder = nil
	end

	builtKey = nil
	lastWalkCrackPos = nil
	wasAirborne = false
end

local function raycastGroundY(fromPos, fallbackY)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local excl = {}
	if LocalPlayer.Character then table.insert(excl, LocalPlayer.Character) end
	if auraFolder then table.insert(excl, auraFolder) end
	if crackRootFolder then table.insert(excl, crackRootFolder) end
	if EspFolder then table.insert(excl, EspFolder) end
	params.FilterDescendantsInstances = excl

	local hit = workspace:Raycast(fromPos + Vector3.new(0, 2.0, 0), Vector3.new(0, -16, 0), params)
	if hit then
		return hit.Position.Y, true
	end
	return fallbackY, false
end

local function makeCrackPart(parent, size, color, material, transparency)
	local p = Instance.new("Part")
	p:SetAttribute("SeniaAuraFX", true)
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Neon
	p.Transparency = transparency or 0
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Parent = parent
	return p
end

local function createCrackSeg(folder, p0, p1, thick, isMega)
	local core = makeCrackPart(
		folder,
		Vector3.new(thick * (isMega and 2.5 or 1.85), 0.12, 1),
		Color3.fromRGB(3, 1, 7),
		Enum.Material.SmoothPlastic,
		0
	)
	local edge = makeCrackPart(
		folder,
		Vector3.new(thick * (isMega and 1.15 or 0.78), 0.14, 1),
		Color3.fromRGB(115, 16, 255),
		Enum.Material.Neon,
		0.05
	)
	return { core = core, edge = edge, p0 = p0, p1 = p1 }
end

local function updateCrackSeg(seg)
	local y0, ok0 = raycastGroundY(seg.p0, seg.p0.Y)
	local y1, ok1 = raycastGroundY(seg.p1, seg.p1.Y)
	if not ok0 and not ok1 then
		seg.core.Transparency = 1
		seg.edge.Transparency = 1
		return
	end
	seg.core.Transparency = 0
	seg.edge.Transparency = 0.05
	local p0W = Vector3.new(seg.p0.X, y0 + 0.04, seg.p0.Z)
	local p1W = Vector3.new(seg.p1.X, y1 + 0.04, seg.p1.Z)
	local dist = (p1W - p0W).Magnitude
	if dist < 0.05 then return end
	local mid = (p0W + p1W) * 0.5
	local cf = CFrame.lookAt(mid, p1W)
	seg.core.Size = Vector3.new(seg.core.Size.X, 0.12, dist * 1.16)
	seg.edge.Size = Vector3.new(seg.edge.Size.X, 0.14, dist * 1.09)
	seg.core.CFrame = cf
	seg.edge.CFrame = cf * CFrame.new(0, 0.015, 0)
end

