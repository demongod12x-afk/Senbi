local function clearAllCharacterAnims(char, hum)
	if hum then
		pcall(function()
			local animator = hum:FindFirstChildOfClass("Animator")
			if animator then
				for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do tr:Stop(0) end
			end
			for _, tr in ipairs(hum:GetPlayingAnimationTracks()) do tr:Stop(0) end
		end)
	end
	if char then
		pcall(function()
			local animScript = char:FindFirstChild("Animate")
			if animScript and animScript:IsA("BaseScript") then
				flyAnimateDisabled = animScript.Enabled
				animScript.Enabled = false
			end
		end)
	end
end

local function restoreCharacterAnims(char)
	if char and flyAnimateDisabled then
		pcall(function()
			local animScript = char:FindFirstChild("Animate")
			if animScript and animScript:IsA("BaseScript") then animScript.Enabled = true end
		end)
	end
	flyAnimateDisabled = false
end

local function stopFly()
	Cfg.Fly = false
	if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
	if flyVelocity then pcall(function() flyVelocity:Destroy() end); flyVelocity = nil end
	if flyGyro then pcall(function() flyGyro:Destroy() end); flyGyro = nil end
	local char, hum = getRig()
	restoreCharacterAnims(char)
	if hum then pcall(function() hum.PlatformStand = false end) end
	if syncFlyUI then pcall(syncFlyUI) end
end

local function startFly()
	stopFly()
	local char, hum, root = getRig()
	if not hum or not root then return end
	Cfg.Fly = true
	clearAllCharacterAnims(char, hum)
	pcall(function() hum.PlatformStand = true end)
	pcall(function() root.CFrame = root.CFrame + Vector3.new(0, 3.5, 0) end)

	local vel = Instance.new("BodyVelocity")
	vel.MaxForce = Vector3.new(1e7, 1e7, 1e7)
	vel.Velocity = Vector3.zero
	vel.Parent = root
	flyVelocity = vel

	local gyro = Instance.new("BodyGyro")
	gyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
	gyro.P = 1e4
	gyro.Parent = root
	flyGyro = gyro

	if syncFlyUI then pcall(syncFlyUI) end

	flyConnection = RunService.RenderStepped:Connect(function(dt)
		if not Cfg.Fly or not root or not root.Parent then
			stopFly()
			return
		end
		local camera = workspace.CurrentCamera
		local move = hum.MoveDirection
		local spd = normalizeFlySpeed(Cfg.FlyVal)
		local desiredVel = Vector3.zero
		if move.Magnitude > 0.05 and camera then
			local camCF = camera.CFrame
			local camLook = camCF.LookVector
			local camRight = camCF.RightVector
			local horizRight = Vector3.new(camRight.X, 0, camRight.Z)
			if horizRight.Magnitude > 1e-4 then horizRight = horizRight.Unit end
			local flatLook = Vector3.new(camLook.X, 0, camLook.Z)
			local forwardAmt = (flatLook.Magnitude > 1e-4) and move:Dot(flatLook.Unit) or move.Magnitude
			local rightAmt = move:Dot(horizRight)
			local aimDir = (camLook * forwardAmt) + (horizRight * rightAmt)
			desiredVel = (aimDir.Magnitude > 1e-4) and (aimDir.Unit * math.clamp(move.Magnitude, 0, 1) * spd) or (move.Unit * spd)
		elseif move.Magnitude > 0.05 then
			desiredVel = move.Unit * spd
		end
		vel.Velocity = desiredVel
		root.AssemblyLinearVelocity = desiredVel
		if desiredVel.Magnitude > 0.05 then
			root.CFrame = root.CFrame + (desiredVel * math.min(dt, 0.05))
		end
		if camera then gyro.CFrame = camera.CFrame end
	end)
end

local function setFlyState(on)
	if on then startFly() else stopFly() end
end

local function getAllActiveAnimTracks(hum)
	local list = {}
	if not hum then return list end
	pcall(function()
		local animator = hum:FindFirstChildOfClass("Animator")
		if animator then
			for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do table.insert(list, tr) end
		end
		for _, tr in ipairs(hum:GetPlayingAnimationTracks()) do
			local dup = false
			for _, existing in ipairs(list) do
				if existing == tr then dup = true; break end
			end
			if not dup then table.insert(list, tr) end
		end
	end)
	return list
end

local function enforceAirWalkStates(hum)
	if not hum then return end
	pcall(function()
		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
		local st = (hum.MoveDirection.Magnitude > 0.05) and Enum.HumanoidStateType.Running or Enum.HumanoidStateType.Landed
		if hum:GetState() ~= st then hum:ChangeState(st) end
	end)
end

local function sanitizeAirWalkAnim(hum)
	if not hum then return end
	pcall(function()
		for _, tr in ipairs(hum:GetPlayingAnimationTracks()) do
			local animName = string.lower((tr.Animation and tr.Animation.Name) or "")
			if string.find(animName, "fall", 1, true) or string.find(animName, "jump", 1, true) or string.find(animName, "climb", 1, true) then
				tr:Stop(0.05)
			end
		end
	end)
end

local function setAirWalkState(on)
	Cfg.AirWalk = (on == true)
	airMoveDir = 0
	airWalkWasMoving = false
	if airGui then airGui.Enabled = Cfg.AirWalk end
	local _, hum, hrp = getRig()
	if Cfg.AirWalk and hrp then
		airY = hrp.Position.Y
		if hum then
			if Cfg.Speed then hum.WalkSpeed = normalizeMovementSpeed(Cfg.SpeedVal) end
			enforceAirWalkStates(hum)
			sanitizeAirWalkAnim(hum)
		end
	else
		airY = nil
		if hum then
			pcall(function()
				hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
				hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
				hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
				hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, not Cfg.Noclip)
				hum.WalkSpeed = Cfg.Speed and normalizeMovementSpeed(Cfg.SpeedVal) or 16
				hum:ChangeState(Enum.HumanoidStateType.GettingUp)
			end)
		end
	end
end

