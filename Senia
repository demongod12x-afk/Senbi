local fpsAccum, fpsFrames, lastStat = 0, 0, 0
RunService.RenderStepped:Connect(function(dt)
	local now = os.clock()
	fpsAccum = fpsAccum + dt
	fpsFrames = fpsFrames + 1
	if fpsAccum >= 0.4 then
		eye1FpsLbl.Text = tostring(math.clamp(math.floor((fpsFrames / fpsAccum) + 0.5), 1, 240)) .. " FPS"
		fpsAccum, fpsFrames = 0, 0
	end
	eye1Pupil.Position = UDim2.new(0.5 + math.cos(now * 2.0) * 0.14, -2.5, 0.5 + math.sin(now * 1.5) * 0.12, -2.5)
	topEyePupil.Position = UDim2.new(0.5 + math.cos(now * 2.2) * 0.12, -2, 0.5 + math.sin(now * 1.8) * 0.1, -2)
	if now - lastStat >= 0.7 then
		lastStat = now
		local pingMs = 0
		pcall(function()
			local dp = Stats.Network.ServerStatsItem["Data Ping"]
			if dp and dp.GetValue then pingMs = math.floor(dp:GetValue()) end
		end)
		topStatsLbl.Text = "PLAYERS: " .. tostring(#Players:GetPlayers()) .. " | PING: " .. tostring(pingMs) .. "ms"
	end
end)
