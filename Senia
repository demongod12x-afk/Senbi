		friendsListFrame.Size = UDim2.new(0.96, 0, 0, math.max(36, fLay.AbsoluteContentSize.Y + 6))
	end)
	refreshCallbacks[2] = function() rebuildFriendsList() end

	rebuildFriendsList = function()
		if not friendsListFrame then return end
		for _, ch in ipairs(friendsListFrame:GetChildren()) do
			if not ch:IsA("UIListLayout") then ch:Destroy() end
		end
		local count = 0
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and isFriend(plr) then
				count = count + 1
				local row = Instance.new("Frame")
				row.Size = UDim2.new(0.98, 0, 0, 38)
				row.BackgroundColor3 = VOID_BG
				row.ZIndex = 33
				row.Parent = friendsListFrame
				Instance.new("UICorner", row).CornerRadius = UDim.new(0, 7)
				addBorder(row, NEON_RING, 1, 0.3)

				local pic = Instance.new("ImageLabel")
				pic.Size = UDim2.new(0, 28, 0, 28)
				pic.Position = UDim2.new(0, 5, 0.5, -14)
				pic.BackgroundColor3 = BTN_OFF
				pic.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(plr.UserId) .. "&w=150&h=150"
				pic.ZIndex = 34
				pic.Parent = row
				Instance.new("UICorner", pic).CornerRadius = UDim.new(1, 0)

				local nLbl = Instance.new("TextLabel")
				nLbl.Size = UDim2.new(1, -148, 1, 0)
				nLbl.Position = UDim2.new(0, 38, 0, 0)
				nLbl.BackgroundTransparency = 1
				nLbl.Font = Enum.Font.GothamBold
				nLbl.TextSize = 10
				nLbl.TextXAlignment = Enum.TextXAlignment.Left
				nLbl.TextColor3 = TEXT_MAIN
				nLbl.TextTruncate = Enum.TextTruncate.AtEnd
				nLbl.ZIndex = 34
				nLbl.Text = plr.DisplayName .. " (@" .. plr.Name .. ")"
				nLbl.Parent = row

				local function mkMini(txt, xOff, colorOff, fn)
					local b = Instance.new("TextButton")
					b.Size = UDim2.new(0, 34, 0, 24)
					b.Position = UDim2.new(1, xOff, 0.5, -12)
					b.BackgroundColor3 = colorOff
					b.Font = Enum.Font.GothamBlack
					b.TextSize = 9
					b.Text = txt
					b.TextColor3 = TEXT_MAIN
					b.ZIndex = 34
					b.Parent = row
					Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
					b.MouseButton1Click:Connect(function() playClick(1.0); fn(b) end)
					return b
				end

				mkMini("TP", -110, BTN_OFF, function()
					local _, _, myR = getRig()
					local tR = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
					if myR and tR then myR.CFrame = tR.CFrame * CFrame.new(0, 0, 3) end
				end)

				mkMini("SPEC", -74, spectatedFriend == plr and BTN_ON or BTN_OFF, function(b)
					local cam = workspace.CurrentCamera
					if spectatedFriend == plr then
						spectatedFriend = nil
						b.BackgroundColor3 = BTN_OFF
						local _, myHum = getRig()
						if cam and myHum then cam.CameraSubject = myHum end
					else
						spectatedFriend = plr
						b.BackgroundColor3 = BTN_ON
						local tHum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
						if cam and tHum then cam.CameraSubject = tHum end
					end
				end)

				mkMini("ESP", -38, friendEspSet[plr] and BTN_ON or BTN_OFF, function(b)
					friendEspSet[plr] = not friendEspSet[plr]
					b.BackgroundColor3 = friendEspSet[plr] and BTN_ON or BTN_OFF
					syncAllESP()
				end)
			end
		end
		if count == 0 then
			local emptyLbl = Instance.new("TextLabel")
			emptyLbl.Size = UDim2.new(0.96, 0, 0, 30)
			emptyLbl.BackgroundTransparency = 1
			emptyLbl.Font = Enum.Font.GothamBold
			emptyLbl.TextSize = 11
			emptyLbl.TextColor3 = TEXT_DIM
			emptyLbl.ZIndex = 34
			emptyLbl.Text = "No friends in this server right now."
			emptyLbl.Parent = friendsListFrame
