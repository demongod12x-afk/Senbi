local function hopServer()
	if not TeleportService or not HttpService or not LocalPlayer then return end
	task.spawn(function()
		local cursor = ""
		local servers = {}
		for _ = 1, 5 do
			local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Asc&limit=100"
			if cursor ~= "" then url = url .. "&cursor=" .. HttpService:UrlEncode(cursor) end
			local ok, raw = pcall(function() return game:HttpGet(url) end)
			if not ok or not raw then break end
			local decOk, data = pcall(function() return HttpService:JSONDecode(raw) end)
			if not decOk or type(data) ~= "table" or type(data.data) ~= "table" then break end
			for _, srv in ipairs(data.data) do
				if type(srv) == "table" and srv.id and srv.id ~= game.JobId then
					local playing = tonumber(srv.playing) or 0
					local maxPlayers = tonumber(srv.maxPlayers) or 0
					if maxPlayers > 0 and playing < maxPlayers then
						table.insert(servers, srv.id)
					end
				end
			end
			if #servers > 0 or not data.nextPageCursor or data.nextPageCursor == "" then break end
			cursor = data.nextPageCursor
		end
		if #servers > 0 then
			local chosen = servers[math.random(1, #servers)]
			pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, chosen, LocalPlayer) end)
		else
			pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end)
		end
	end)
end

