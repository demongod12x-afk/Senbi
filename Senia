local function sendChatMessage(msg)
	local text = tostring(msg or "")
	if text == "" then return end
	pcall(function()
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local channels = TextChatService:FindFirstChild("TextChannels")
			local general = channels and (channels:FindFirstChild("RBXGeneral") or channels:GetChildren()[1])
			if general and type(general.SendAsync) == "function" then
				general:SendAsync(text)
				return
			end
		end
	end)
	pcall(function()
		local ev = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
		local sayReq = ev and ev:FindFirstChild("SayMessageRequest")
		if sayReq and type(sayReq.FireServer) == "function" then
			sayReq:FireServer(text, "All")
		end
	end)
end

