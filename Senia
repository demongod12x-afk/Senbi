		if not on then local _, h = getRig(); if h then h.WalkSpeed = 16 end end
	end, function() return Cfg.SpeedVal end, function(v) Cfg.SpeedVal = v end, 0, nil, function(v)
		if Cfg.Speed then local _, h = getRig(); if h then h.WalkSpeed = normalizeMovementSpeed(v) end end
	end)

	makeNumRow(p3, "JUMP POWER", function() return Cfg.Jump end, function(on, v)
		Cfg.Jump = on; Cfg.JumpVal = v
		if not on then local _, h = getRig(); if h then h.UseJumpPower = true; h.JumpPower = 50 end end
	end, function() return Cfg.JumpVal end, function(v) Cfg.JumpVal = v end, 0, nil, function(v)
		if Cfg.Jump then local _, h = getRig(); if h then h.UseJumpPower = true; h.JumpPower = normalizeJumpPower(v) end end
	end)

	makeNumRow(p3, "FLY", function() return Cfg.Fly end, function(on, v)
		Cfg.FlyVal = v
		setFlyState(on)
	end, function() return Cfg.FlyVal end, function(v) Cfg.FlyVal = v end, 0, function(fn)
		syncFlyUI = fn
	end, function(v)
		Cfg.FlyVal = v
	end)

	makeToggle(p3, "AIR WALK", function() return Cfg.AirWalk end, function(v) setAirWalkState(v) end)

	makeNumRow(p3, "SPIN", function() return Cfg.Spin end, function(on, v)
		Cfg.Spin = on; Cfg.SpinVal = v
	end, function() return Cfg.SpinVal end, function(v) Cfg.SpinVal = v end, nil)

	makeNumRow(p3, "EMOTE SPEED", function() return Cfg.EmoteSpeed end, function(on, v)
		Cfg.EmoteSpeed = on; Cfg.EmoteVal = v
		if not on then
			local _, h = getRig()
			if h then
				for _, tr in ipairs(getAllActiveAnimTracks(h)) do pcall(function() tr:AdjustSpeed(1) end) end
			end
		end
	end, function() return Cfg.EmoteVal end, function(v) Cfg.EmoteVal = v end, nil)
end

