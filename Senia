		local parsed = parseNum(box.Text, getVal(), minV)
		setVal(parsed)
		if liveApplyFn then
			pcall(liveApplyFn, parsed)
		end
	end)

	box.FocusLost:Connect(function()
		local parsed = parseNum(box.Text, getVal(), minV)
		setVal(parsed)
		box.Text = tostring(parsed)
		if liveApplyFn then
			pcall(liveApplyFn, parsed)
		elseif getState() == true then
			setState(true, parsed)
		end
	end)
end

