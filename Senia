local function scaleAuraNumberSeq(seq, mult, minClamp, maxClamp)
	local kps = {}
	for _, kp in ipairs(seq.Keypoints) do
		local val = kp.Value * mult
		if minClamp or maxClamp then
			val = math.clamp(val, minClamp or -math.huge, maxClamp or math.huge)
		end
		table.insert(kps, NumberSequenceKeypoint.new(kp.Time, val))
	end
	return NumberSequence.new(kps)
end

local function raycastAuraGroundY(fromPos, fallbackY)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local excl = {}
	if LocalPlayer.Character then table.insert(excl, LocalPlayer.Character) end
	if auraWorldFolder then table.insert(excl, auraWorldFolder) end
	if crackRootFolder then table.insert(excl, crackRootFolder) end
	params.FilterDescendantsInstances = excl
	local hit = workspace:Raycast(fromPos + Vector3.new(0, 2.0, 0), Vector3.new(0, -16, 0), params)
	return hit and hit.Position.Y or fallbackY, hit ~= nil
end

local function makeCrackPart(parent, size, color, material, transparency)
	local p = Instance.new("Part")
	markAuraOwned(p, "MortalCrackPart")
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Neon
	p.Transparency = transparency or 0
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Parent = parent
	return p
end

local function createCrackSeg(folder, p0, p1, thick, isMega, edgeColor)
	local core = makeCrackPart(folder, Vector3.new(thick * (isMega and 2.5 or 1.85), 0.12, 1), Color3.fromRGB(3, 1, 7), Enum.Material.SmoothPlastic, 0)
	local edge = makeCrackPart(folder, Vector3.new(thick * (isMega and 1.15 or 0.78), 0.14, 1), edgeColor or Color3.fromRGB(115, 16, 255), Enum.Material.Neon, 0.05)
	return { core = core, edge = edge, p0 = p0, p1 = p1 }
end

local function updateCrackSeg(seg)
	local y0, ok0 = raycastAuraGroundY(seg.p0, seg.p0.Y)
	local y1, ok1 = raycastAuraGroundY(seg.p1, seg.p1.Y)
	if not ok0 and not ok1 then
		seg.core.Transparency = 1
		seg.edge.Transparency = 1
		return
	end
	local p0W = Vector3.new(seg.p0.X, y0 + 0.04, seg.p0.Z)
	local p1W = Vector3.new(seg.p1.X, y1 + 0.04, seg.p1.Z)
	local dist = (p1W - p0W).Magnitude
	if dist < 0.05 then return end
	local cf = CFrame.lookAt((p0W + p1W) * 0.5, p1W)
	seg.core.Size = Vector3.new(seg.core.Size.X, 0.12, dist * 1.16)
	seg.edge.Size = Vector3.new(seg.edge.Size.X, 0.14, dist * 1.09)
	seg.core.CFrame = cf
	seg.edge.CFrame = cf * CFrame.new(0, 0.015, 0)
end

local function createRiftPopup(folder, scale, textCol)
	local holder = makeCrackPart(folder, Vector3.new(0.2, 0.2, 0.2), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic, 1)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(0, 190 * scale, 0, 30 * scale)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Parent = holder

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, 0, 1, 0)
	lbl.BackgroundTransparency = 1
	lbl.Font = Enum.Font.GothamBlack
	lbl.TextScaled = true
	lbl.Text = "MORTALS NEVERDIE"
	lbl.TextColor3 = textCol or Color3.fromRGB(165, 55, 255)
	lbl.TextStrokeColor3 = Color3.fromRGB(8, 1, 18)
	lbl.TextStrokeTransparency = 0
	lbl.Parent = bb

	local st = Instance.new("UIStroke")
	st.Color = Color3.fromRGB(80, 10, 185)
	st.Thickness = 2
	st.Parent = lbl

	return { holder = holder, bb = bb, label = lbl }
end

local function spawnWalkCrack(item, groundPos, moveDir, scale)
	if not item.crackFolder or not item.crackFolder.Parent then return end
	local set = buildAuraColorSet("MORTALS_NEVERDIE")
	local node = Instance.new("Folder")
	node.Name = "WalkCrackNode"
	markAuraOwned(node, "MortalCrackNode")
	node.Parent = item.crackFolder
	local segs = {}
	for b = 1, 5 do
		local ang = math.atan2(moveDir.Z, moveDir.X) + (((b - 3) / 2.5) * 1.45)
		local cur = groundPos
		local segLen = 0.72 * scale
		for s = 1, 3 do
			ang = ang + (((s % 2 == 0) and 1 or -1) * 0.52)
			local nxt = cur + Vector3.new(math.cos(ang), 0, math.sin(ang)) * segLen
			table.insert(segs, createCrackSeg(node, cur, nxt, 0.25 * scale, false, set.Outline))
			cur = nxt
		end
	end
	table.insert(item.walkCracks, {
		folder = node, segs = segs, popup = createRiftPopup(node, scale, set.Start),
		originPos = groundPos, spawnTime = os.clock(), duration = 2.2
	})
	if #item.walkCracks > 14 then
		local old = table.remove(item.walkCracks, 1)
		pcall(function() old.folder:Destroy() end)
	end
end

local function spawnLandingMegaCrack(item, groundPos, scale)
	if not item.crackFolder or not item.crackFolder.Parent then return end
	local set = buildAuraColorSet("MORTALS_NEVERDIE")
	local node = Instance.new("Folder")
	node.Name = "LandingMegaCrackNode"
	markAuraOwned(node, "MortalCrackNode")
	node.Parent = item.crackFolder
	local segs = {}
	local armCount = 14
	local reach = 9.5 * scale
	for i = 1, armCount do
		local baseAng = ((i - 1) / armCount) * math.pi * 2
		local cur = groundPos
		local ang = baseAng
		for s = 1, 4 do
			ang = ang + (((s % 2 == 0) and 1 or -1) * 0.40)
			local nxt = cur + Vector3.new(math.cos(ang), 0, math.sin(ang)) * (reach / 4)
			table.insert(segs, createCrackSeg(node, cur, nxt, 0.38 * scale, true, set.Outline))
			cur = nxt
		end
	end
	table.insert(item.landingCracks, {
		folder = node, segs = segs, popup = createRiftPopup(node, scale * 1.25, set.Start),
		originPos = groundPos, spawnTime = os.clock(), duration = 3.0
	})
	if #item.landingCracks > 6 then
		local old = table.remove(item.landingCracks, 1)
		pcall(function() old.folder:Destroy() end)
	end
end

local function attachStarEmitterEntry(parentPart, opts)
	local pe = Instance.new("ParticleEmitter")
	markAuraOwned(pe, "MortalStarRadiance")
	pe.Texture = STAR_TEXTURE
	pe.Color = opts.color
	pe.Size = opts.size
	pe.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(0.60, 0.25), NumberSequenceKeypoint.new(1, 1),
	})
	pe.Lifetime = NumberRange.new(0.45, 0.85)
	pe.Rate = math.max(120, math.floor(opts.rate or 260))
	pe.Speed = opts.speed
	pe.SpreadAngle = opts.spread
	pe.RotSpeed = opts.rotSpeed
	pe.Rotation = NumberRange.new(-180, 180)
	pe.Drag = 1.15
	pe.LightEmission = 0.95
	pe.Acceleration = opts.accel
	pe.Enabled = true
	pe.Parent = parentPart
	return { emitter = pe, kind = "star", baseRate = pe.Rate, baseSize = opts.size, baseSpeed = opts.speed, baseSpread = opts.spread }
end

local function buildAura(char, hrp)
	if not char or not hrp then return end
	local modeName = AURA_MODES[Cfg.AuraModeIdx] or "COLUMN"
	local lvl = math.clamp(math.floor(tonumber(Cfg.AuraLevel) or 1), 1, MAX_AURA_LEVEL)
	local isUltimate = (Cfg.UltimateSpread == true)
	clearAuraEffects()

	builtAuraMode = modeName
	builtAuraLevel = lvl
	builtAuraUltimate = isUltimate
	builtAuraChar = char
	builtAuraColorSig = getAuraColorSignature()

	local fxFolder = Instance.new("Folder")
	fxFolder.Name = "MortalsAuraFX"
	markAuraOwned(fxFolder, "MortalAuraFolder")
	fxFolder.Parent = char
	auraWorldFolder = fxFolder

	local activeSet = buildAuraColorSet(modeName)
	local emitters = {}
	local spreadEmitters = {}
	local extras = {}
	local ptLight = nil

	if modeName == "SMOKE" then
		local preset = isUltimate and ULTIMATE_SPREAD_PRESET or (SMOKE_PRESETS[lvl] or SMOKE_PRESETS[1])
		local parts = getAuraTargetParts(char)
		local smokeSeq = makeAuraSequence("SMOKE")
		if isUltimate then
			applyAuraUltimateGlow(char, "SMOKE", extras)
			attachAuraUltimateSpread(char, "SMOKE", SURGE_TEXTURES, spreadEmitters)
		end
		local offsets = isUltimate and {
			Vector3.new(-0.55, 0.35, 0), Vector3.new(0.55, -0.25, 0),
			Vector3.new(0, 0.25, 0.55), Vector3.new(0, -0.35, -0.55),
		} or {
			Vector3.new(-0.32, 0.25, 0), Vector3.new(0.32, -0.25, 0),
			Vector3.new(0, 0, 0.32), Vector3.new(0, -0.35, 0),
		}
		local minAuraRate = isUltimate and 40 or ((lvl == 1) and 10 or ((lvl == 2) and 28 or 42))
		local maxAuraRate = isUltimate and 16000 or 1200
		local maxShardRate = isUltimate and 11000 or 900
		local maxSurgeRate = isUltimate and 13000 or 1000

		for _, part in ipairs(parts) do
			local legBoost = (isAuraLegOrFoot(part) and (isUltimate or lvl >= 3)) and 1.35 or ((isAuraLegOrFoot(part) and lvl == 2) and 1.15 or 1.0)
			for i = 1, 4 do
				local att = Instance.new("Attachment")
				att.Name = "MortalAuraAtt_" .. tostring(i)
				att.Position = offsets[i] or Vector3.zero
				markAuraOwned(att, "MortalSmokeAtt")
				att.Parent = part
				table.insert(activeAuraAttachments, att)

				local aura = Instance.new("ParticleEmitter")
				aura.Name = "MortalDarkNeonAura"
				markAuraOwned(aura, "MortalSmokeAura")
				aura.Parent = att
				aura.Color = smokeSeq
				aura.Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, math.clamp(0.80 * preset.sizeMult * legBoost, 0.1, 40)),
					NumberSequenceKeypoint.new(0.55, math.clamp(1.85 * preset.sizeMult * legBoost, 0.2, 78)),
					NumberSequenceKeypoint.new(1, math.clamp(0.15 * (isUltimate and 18 or 1), 0.1, 18)),
				})
				aura.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, isUltimate and 0.50 or ((lvl == 1) and 0.35 or ((lvl == 2) and 0.24 or 0.14))),
					NumberSequenceKeypoint.new(0.55, isUltimate and 0.66 or ((lvl == 1) and 0.65 or ((lvl == 2) and 0.52 or 0.38))),
					NumberSequenceKeypoint.new(1, 1),
				})
				aura.Lifetime = NumberRange.new((not isUltimate and lvl == 1) and 0.45 or 0.75, (not isUltimate and lvl == 1) and 0.75 or (isUltimate and 1.5 or 1.25))
				aura.Rate = math.clamp(34 * preset.rateMult * legBoost, minAuraRate, maxAuraRate)
				aura.Speed = NumberRange.new(math.clamp(2.8 * preset.speedMult, 0.5, 220), math.clamp(7.2 * preset.speedMult, 1.0, 320))
				aura.SpreadAngle = Vector2.new(360, 360)
				aura.Rotation = NumberRange.new(-180, 180)
				aura.RotSpeed = NumberRange.new(-180 * (isUltimate and 4 or 1), 180 * (isUltimate and 4 or 1))
				aura.LightEmission = 0
				aura.LightInfluence = 0.25
				aura.Enabled = true
				table.insert(activeAuraEmitters, aura)
				table.insert(emitters, aura)

				if preset.shards then
					local shards = Instance.new("ParticleEmitter")
					shards.Name = "MortalDarkNeonShards"
					markAuraOwned(shards, "MortalSmokeAura")
					shards.Parent = att
					shards.Color = smokeSeq
					shards.Size = NumberSequence.new({
						NumberSequenceKeypoint.new(0, math.clamp(0.34 * preset.sizeMult * legBoost, 0.05, 28)),
						NumberSequenceKeypoint.new(1, 0),
					})
					shards.Transparency = NumberSequence.new({
						NumberSequenceKeypoint.new(0, isUltimate and 0.42 or ((lvl == 1) and 0.25 or 0.08)),
						NumberSequenceKeypoint.new(1, 1),
					})
					shards.Lifetime = NumberRange.new((not isUltimate and lvl == 1) and 0.3 or 0.5, (not isUltimate and lvl == 1) and 0.55 or 0.95)
					shards.Rate = math.clamp(22 * preset.rateMult * legBoost, (not isUltimate and lvl == 1) and 8 or ((not isUltimate and lvl == 2) and 22 or 35), maxShardRate)
					shards.Speed = NumberRange.new(math.clamp(5.0 * preset.speedMult, 1.0, 260), math.clamp(12.0 * preset.speedMult, 2.0, 400))
					shards.SpreadAngle = Vector2.new(360, 360)
					shards.LightEmission = 0
					shards.LightInfluence = 0.25
					shards.Enabled = true
					table.insert(activeAuraEmitters, shards)
					table.insert(emitters, shards)
				end

				if preset.surge then
					local surge = Instance.new("ParticleEmitter")
					surge.Name = "MortalDarkNeonSurge"
					markAuraOwned(surge, "MortalSmokeAura")
					surge.Parent = att
					surge.Color = smokeSeq
					surge.Size = NumberSequence.new({
						NumberSequenceKeypoint.new(0, math.clamp(1.2 * preset.sizeMult * legBoost, 0.2, 58)),
						NumberSequenceKeypoint.new(0.7, math.clamp(2.65 * preset.sizeMult * legBoost, 0.4, 92)),
						NumberSequenceKeypoint.new(1, math.clamp(0.15 * (isUltimate and 18 or 1), 0.1, 22)),
					})
					surge.Transparency = NumberSequence.new({
						NumberSequenceKeypoint.new(0, isUltimate and 0.50 or 0.2), NumberSequenceKeypoint.new(1, 1),
					})
					surge.Lifetime = NumberRange.new(0.6, isUltimate and 1.35 or 1.05)
					surge.Rate = math.clamp(28 * preset.rateMult * legBoost, 45, maxSurgeRate)
					surge.Speed = NumberRange.new(math.clamp(3.5 * preset.speedMult, 1.0, 240), math.clamp(9.0 * preset.speedMult, 2.0, 360))
					surge.SpreadAngle = Vector2.new(360, 360)
					surge.RotSpeed = NumberRange.new(-240 * (isUltimate and 4 or 1), 240 * (isUltimate and 4 or 1))
					surge.LightEmission = 0
					surge.LightInfluence = 0.25
					surge.Enabled = true
					table.insert(activeAuraEmitters, surge)
					table.insert(emitters, surge)
				end
			end
		end
	elseif modeName == "COLUMN" then
		local cfg = COLUMN_CONFIG[lvl] or COLUMN_CONFIG[1]
		local bodyParts = collectAuraBodyParts(char, hrp)
		for idx, bp in ipairs(bodyParts) do
			local texIdx = ((idx - 1) % 2) + 1
			for _, entry in ipairs({
				createColumnEmitterEntry(bp, cfg, #bodyParts, true, texIdx),
				createColumnEmitterEntry(bp, cfg, #bodyParts, false, texIdx),
				createColumnSparkEntry(bp, cfg, #bodyParts),
			}) do
				table.insert(emitters, entry)
				table.insert(activeAuraEmitters, entry)
			end
		end
		ptLight = Instance.new("PointLight")
		markAuraOwned(ptLight, "MortalColumnAura")
		ptLight.Color = activeSet.Light
		ptLight.Brightness = cfg.lightBright
		ptLight.Range = cfg.lightRange
		ptLight.Parent = hrp
		if isUltimate then
			applyAuraUltimateGlow(char, "COLUMN", extras)
			attachAuraUltimateSpread(char, "COLUMN", COLUMN_TEXTURES, spreadEmitters)
		end
	elseif modeName == "SURGE" then
		local cfg = SURGE_CONFIG[lvl] or SURGE_CONFIG[1]
		local bodyParts = collectAuraBodyParts(char, hrp)
		for idx, bp in ipairs(bodyParts) do
			local texIdx = ((idx - 1) % #SURGE_TEXTURES) + 1
			for _, entry in ipairs({
				createSurgeCloudEntry(bp, cfg, #bodyParts, false, texIdx),
				createSurgeCloudEntry(bp, cfg, #bodyParts, true, texIdx),
				createSurgeWispEntry(bp, cfg, #bodyParts, texIdx),
			}) do
				table.insert(emitters, entry)
				table.insert(activeAuraEmitters, entry)
			end
		end
		ptLight = Instance.new("PointLight")
		markAuraOwned(ptLight, "MortalSurgeAura")
		ptLight.Color = activeSet.Light
		ptLight.Brightness = cfg.lightBright
		ptLight.Range = cfg.lightRange
		ptLight.Parent = hrp
		if isUltimate then
			applyAuraUltimateGlow(char, "SURGE", extras)
			attachAuraUltimateSpread(char, "SURGE", SURGE_TEXTURES, spreadEmitters)
		end
	elseif modeName == "STAR_RADIANCE" then
		local tier = STAR_RADIANCE_TIERS[lvl] or STAR_RADIANCE_TIERS[1]
		local avatarScale = getAvatarHeightRatio(char, char:FindFirstChild("Head"))
		local fixedScale = math.clamp(avatarScale, 0.85, 1.40)
		local bodyParts = collectAuraBodyParts(char, hrp)
		local baseRate = math.max(120, math.floor((260 * tier.rateMult) / #bodyParts))
		local sMult = tier.sizeMult * fixedScale
		local seq = makeAuraSequence("STAR_RADIANCE")

		for _, bp in ipairs(bodyParts) do
			local s1 = attachStarEmitterEntry(bp, {
				color = seq,
				size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.65 * sMult), NumberSequenceKeypoint.new(0.55, 1.55 * sMult), NumberSequenceKeypoint.new(1, 0),
				}),
				rate = baseRate, speed = NumberRange.new(4.5 * tier.speedMult, 11.5 * tier.speedMult),
				spread = Vector2.new(math.clamp(135 * tier.spreadMult, 50, 180), math.clamp(135 * tier.spreadMult, 50, 180)),
				rotSpeed = NumberRange.new(-120, 120), accel = Vector3.new(0, 6.0, 0),
			})
			local s2 = attachStarEmitterEntry(bp, {
				color = seq,
				size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.60 * sMult), NumberSequenceKeypoint.new(0.60, 1.45 * sMult), NumberSequenceKeypoint.new(1, 0),
				}),
				rate = baseRate, speed = NumberRange.new(4.5 * tier.speedMult, 11.5 * tier.speedMult),
				spread = Vector2.new(math.clamp(170 * tier.spreadMult, 50, 180), math.clamp(170 * tier.spreadMult, 50, 180)),
				rotSpeed = NumberRange.new(-155, 155), accel = Vector3.new(0, 4.0, 0),
			})
			table.insert(emitters, s1); table.insert(emitters, s2)
			table.insert(activeAuraEmitters, s1); table.insert(activeAuraEmitters, s2)
		end

		ptLight = Instance.new("PointLight")
		markAuraOwned(ptLight, "MortalStarRadiance")
		ptLight.Color = activeSet.Light
		ptLight.Range = tier.lightRange
		ptLight.Brightness = tier.lightBright
		ptLight.Parent = hrp
		if isUltimate then
			applyAuraUltimateGlow(char, "STAR_RADIANCE", extras)
			attachAuraUltimateSpread(char, "STAR_RADIANCE", { STAR_TEXTURE }, spreadEmitters)
		end

		table.insert(activeAuraItems, {
			mode = modeName, emitters = emitters, spreadEmitters = spreadEmitters, extras = extras,
			light = ptLight, avatarScale = avatarScale, fixedScale = fixedScale, lastBurstTick = -1,
		})
		return
	elseif modeName == "MORTALS_NEVERDIE" then
		local tier = STAR_RADIANCE_TIERS[lvl] or STAR_RADIANCE_TIERS[1]
		local fixedScale = math.clamp(getAvatarHeightRatio(char, char:FindFirstChild("Head")), 0.85, 1.40)

		local cFolder = Instance.new("Folder")
		cFolder.Name = "MortalsGroundCracks"
		markAuraOwned(cFolder, "MortalCrackRoot")
		cFolder.Parent = workspace
		crackRootFolder = cFolder

		ptLight = Instance.new("PointLight")
		markAuraOwned(ptLight, "MortalNeverDieLight")
		ptLight.Color = activeSet.Light
		ptLight.Range = tier.lightRange
		ptLight.Brightness = tier.lightBright
		ptLight.Parent = hrp
		if isUltimate then
			applyAuraUltimateGlow(char, "MORTALS_NEVERDIE", extras)
			attachAuraUltimateSpread(char, "MORTALS_NEVERDIE", { STAR_TEXTURE, SURGE_TEXTURES[1] }, spreadEmitters)
		end

		table.insert(activeAuraItems, {
			mode = modeName, crackFolder = cFolder, walkCracks = {}, landingCracks = {},
			spreadEmitters = spreadEmitters, extras = extras, fixedScale = fixedScale, light = ptLight,
		})
		return
	end

	table.insert(activeAuraItems, {
		mode = modeName, emitters = emitters, spreadEmitters = spreadEmitters, extras = extras, light = ptLight,
	})
end

local function stepAura(now, char, hum, hrp)
	local modeName = AURA_MODES[Cfg.AuraModeIdx] or "COLUMN"
	local lvl = math.clamp(math.floor(tonumber(Cfg.AuraLevel) or 1), 1, MAX_AURA_LEVEL)
	local isUltimate = (Cfg.UltimateSpread == true)
	local colorSig = getAuraColorSignature()

	if not Cfg.AuraEnabled or not char or not hum or hum.Health <= 0 or not hrp then
		if builtAuraMode ~= nil or #activeAuraEmitters > 0 or crackRootFolder ~= nil then
			clearAuraEffects()
		end
		return
	end

	if builtAuraChar ~= char or builtAuraMode ~= modeName or builtAuraLevel ~= lvl or builtAuraUltimate ~= isUltimate then
		buildAura(char, hrp)
	elseif builtAuraColorSig ~= colorSig then
		applyLiveAuraColorOnly()
	end

	if modeName == "SMOKE" then return end

	local horizVel = Vector3.new(hrp.AssemblyLinearVelocity.X, 0, hrp.AssemblyLinearVelocity.Z)
	local isIdle = horizVel.Magnitude <= 1.2
	local activeSeq = makeAuraSequence(modeName)

	for _, item in ipairs(activeAuraItems) do
		if modeName == "SURGE" then
			local cfg = SURGE_CONFIG[lvl] or SURGE_CONFIG[1]
			local moveFactor = math.clamp(horizVel.Magnitude / 16, 0, 2.5)
			local rateBoost = isIdle and cfg.idleMult or (1 + (moveFactor * 1.35))
			local sizeBoost = isIdle and 1.12 or (1 + (moveFactor * 0.22))
			local burstTick = math.floor(now * 14)
			local shouldBurst = (not isUltimate) and (not isIdle) and (moveFactor > 0.15) and (burstTick ~= lastSurgeBurstTick)
			if shouldBurst then lastSurgeBurstTick = burstTick end

			for _, entry in ipairs(item.emitters or {}) do
				local pe = entry.emitter
				if pe and pe.Parent and entry.baseRate then
					pe.Enabled = true
					pe.Color = activeSeq
					pe.LightEmission = 0
					pe.LightInfluence = 0.35
					if isUltimate then
						pe.Rate = math.clamp(entry.baseRate * ULTIMATE_SPREAD_PRESET.rateMult, 40, 16000)
						pe.Size = scaleAuraNumberSeq(entry.baseSize, ULTIMATE_SPREAD_PRESET.sizeMult, 0.2, 78)
						pe.Speed = NumberRange.new(math.clamp(entry.baseSpeedMin * ULTIMATE_SPREAD_PRESET.speedMult, 1.2, 240), math.clamp(entry.baseSpeedMax * ULTIMATE_SPREAD_PRESET.speedMult, 2.5, 350))
						pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.28), NumberSequenceKeypoint.new(0.55, 0.46), NumberSequenceKeypoint.new(1, 1) })
						pe.SpreadAngle = Vector2.new(360, 360)
						pe.Drag = 1.0
						pe.RotSpeed = NumberRange.new(-360, 360)
						pe.Acceleration = Vector3.new(0, 14, 0)
					else
						pe.Rate = math.max(entry.minRate or 10, math.floor(entry.baseRate * rateBoost))
						pe.Size = scaleAuraNumberSeq(entry.baseSize, sizeBoost)
						pe.Speed = NumberRange.new(entry.baseSpeedMin, entry.baseSpeedMax)
						pe.SpreadAngle = Vector2.new(entry.baseSpread, entry.baseSpread)
						pe.RotSpeed = NumberRange.new(-entry.baseRotSpeed, entry.baseRotSpeed)
						if shouldBurst then
							local counterDrag = -horizVel * 0.45
							pe.Acceleration = Vector3.new(entry.baseAccel.X + counterDrag.X, entry.baseAccel.Y, entry.baseAccel.Z + counterDrag.Z)
							pe:Emit(entry.kind == "cloud" and 2 or 1)
						else
							pe.Acceleration = entry.baseAccel
						end
					end
				end
			end
			if item.light and item.light.Parent then
				item.light.Range = cfg.lightRange
				item.light.Brightness = cfg.lightBright + math.sin(now * 4.5) * 0.25
			end
		elseif modeName == "COLUMN" then
			local cfg = COLUMN_CONFIG[lvl] or COLUMN_CONFIG[1]
			for _, entry in ipairs(item.emitters or {}) do
				local pe = entry.emitter
				if pe and pe.Parent and entry.baseRate then
					pe.Enabled = true
					pe.Color = activeSeq
					if isUltimate then
						pe.LightEmission = 0
						pe.LightInfluence = 0.25
						pe.Rate = math.clamp(entry.baseRate * ULTIMATE_SPREAD_PRESET.rateMult, 50, 16000)
						pe.Size = scaleAuraNumberSeq(entry.baseSize, ULTIMATE_SPREAD_PRESET.sizeMult, 0.2, 85)
						pe.Speed = NumberRange.new(math.clamp(entry.baseSpeedMin * ULTIMATE_SPREAD_PRESET.speedMult, 1.5, 280), math.clamp(entry.baseSpeedMax * ULTIMATE_SPREAD_PRESET.speedMult, 3, 400))
						pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.24), NumberSequenceKeypoint.new(0.55, 0.40), NumberSequenceKeypoint.new(1, 1) })
						pe.SpreadAngle = Vector2.new(195, 195)
						pe.Drag = 2.4
						pe.RotSpeed = NumberRange.new(-140, 140)
						pe.Acceleration = Vector3.new(0, 65, 0)
					else
						pe.LightInfluence = 0.25
						pe.Rate = math.max(entry.minRate or 24, entry.baseRate)
						pe.Size = entry.baseSize
						pe.Speed = NumberRange.new(entry.baseSpeedMin, entry.baseSpeedMax)
						pe.SpreadAngle = Vector2.new(entry.baseSpread, entry.baseSpread)
						pe.RotSpeed = NumberRange.new(-entry.baseRotSpeed, entry.baseRotSpeed)
					end
				end
			end
			if item.light and item.light.Parent then
				item.light.Range = cfg.lightRange
				item.light.Brightness = cfg.lightBright + math.sin(now * 4.5) * 0.25
			end
		elseif modeName == "STAR_RADIANCE" then
			local tier = STAR_RADIANCE_TIERS[lvl] or STAR_RADIANCE_TIERS[1]
			local wakeOffset = (horizVel.Magnitude > 0.6)
				and (-horizVel.Unit * math.clamp(horizVel.Magnitude / 16, 0, 1) * (4.5 * (item.avatarScale or 1) * tier.reachMult))
				or Vector3.zero
			local burstTick = math.floor(now * (4.2 * tier.speedMult))
			local emitNow = (burstTick ~= (item.lastBurstTick or -1))
			if emitNow then item.lastBurstTick = burstTick end

			local sMult = tier.sizeMult * (item.fixedScale or 1) * (isUltimate and 8.5 or 1)
			for idx, entry in ipairs(item.emitters or {}) do
				local pe = entry.emitter
				if pe and pe.Parent then
					pe.Enabled = true
					pe.Color = activeSeq
					local baseMin = (idx % 2 == 1) and 0.65 or 0.60
					local baseMid = (idx % 2 == 1) and 1.55 or 1.45
					pe.Size = NumberSequence.new({
						NumberSequenceKeypoint.new(0, math.clamp(baseMin * sMult, 0.1, 60)),
						NumberSequenceKeypoint.new(0.55, math.clamp(baseMid * sMult, 0.2, 85)),
						NumberSequenceKeypoint.new(1, 0),
					})
					pe.Speed = NumberRange.new(math.clamp(4.5 * tier.speedMult * (isUltimate and 6 or 1), 1, 240), math.clamp(11.5 * tier.speedMult * (isUltimate and 6 or 1), 2, 320))
					local baseSpread = (idx % 2 == 1) and 135 or 170
					local clampedSpread = isUltimate and 360 or math.clamp(baseSpread * tier.spreadMult, 50, 180)
					pe.SpreadAngle = Vector2.new(clampedSpread, clampedSpread)
					pe.Acceleration = Vector3.new(wakeOffset.X * 5.0, (idx % 2 == 1) and 6.0 or 4.0, wakeOffset.Z * 5.0)
					if emitNow then
						pe:Emit(math.max(2, math.floor((tier.burst * (isUltimate and 3 or 1)) / math.max(1, #item.emitters))))
					end
				end
			end
			if item.light and item.light.Parent then
				item.light.Range = tier.lightRange
				item.light.Brightness = tier.lightBright + math.sin(now * 6) * 0.25
			end
		elseif modeName == "MORTALS_NEVERDIE" then
			local tier = STAR_RADIANCE_TIERS[lvl] or STAR_RADIANCE_TIERS[1]
			local airborne = (hum.FloorMaterial == Enum.Material.Air) and (hrp.AssemblyLinearVelocity.Y < -2)
			local gY, grounded = raycastAuraGroundY(hrp.Position, hrp.Position.Y - 3)
			local groundPos = Vector3.new(hrp.Position.X, gY, hrp.Position.Z)
			local crackScale = (item.fixedScale or 1) * tier.sizeMult * (isUltimate and 1.85 or 1.0)

			if airborne then wasAirborne = true
			elseif wasAirborne and grounded then
				wasAirborne = false
				spawnLandingMegaCrack(item, groundPos, crackScale)
			end

			if not airborne and grounded and horizVel.Magnitude > 2.5 then
				if not lastWalkCrackPos or (groundPos - lastWalkCrackPos).Magnitude >= (2.8 / tier.speedMult) then
					lastWalkCrackPos = groundPos
					local mDir = (hum.MoveDirection.Magnitude > 0.1) and hum.MoveDirection.Unit or horizVel.Unit
					spawnWalkCrack(item, groundPos, mDir, crackScale)
				end
			end

			local function updateList(list)
				for i = #list, 1, -1 do
					local c = list[i]
					local age = now - c.spawnTime
					if age >= c.duration then
						pcall(function() c.folder:Destroy() end)
						table.remove(list, i)
					else
						for _, seg in ipairs(c.segs) do updateCrackSeg(seg) end
						if c.popup and c.popup.holder then
							c.popup.holder.CFrame = CFrame.new(c.originPos + Vector3.new(0, 1.4 + age * 1.1, 0))
							local fade = math.clamp((age - c.duration * 0.65) / (c.duration * 0.35), 0, 1)
							c.popup.label.TextTransparency = fade
							c.popup.label.TextStrokeTransparency = fade
						end
					end
				end
			end
			updateList(item.walkCracks or {})
			updateList(item.landingCracks or {})
			if item.light and item.light.Parent then
				item.light.Range = tier.lightRange
				item.light.Brightness = tier.lightBright + math.sin(now * 5) * 0.2
			end
		end
	end
end

