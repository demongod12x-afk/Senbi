-- Exact Click TP Handler
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not State.ClickTpEnabled or gameProcessed then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		local cam = workspace.CurrentCamera
		local _, _, hrp = getRig()
		if not cam or not hrp then return end

		local screenPos = input.Position
		local ray = cam:ViewportPointToRay(screenPos.X, screenPos.Y)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local excl = {}
		if LocalPlayer.Character then table.insert(excl, LocalPlayer.Character) end
		if auraFolder then table.insert(excl, auraFolder) end
		if crackRootFolder then table.insert(excl, crackRootFolder) end
		if EspFolder then table.insert(excl, EspFolder) end
		if airWalkPart then table.insert(excl, airWalkPart) end
		params.FilterDescendantsInstances = excl

		local hit = workspace:Raycast(ray.Origin, ray.Direction * 1500, params)
		if hit then
			local targetPos = hit.Position + Vector3.new(0, 3.0, 0)
			-- Ensure safe clearance above ground/surface without getting stuck
			local downHit = workspace:Raycast(targetPos + Vector3.new(0, 0.5, 0), Vector3.new(0, -4.0, 0), params)
			if downHit then
				targetPos = Vector3.new(hit.Position.X, downHit.Position.Y + 3.05, hit.Position.Z)
			end
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.CFrame = CFrame.new(targetPos) * hrp.CFrame.Rotation
		end
	end
end)

