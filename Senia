UserInputService.InputBegan:Connect(function(inp, gp)
	if inp.KeyCode == Enum.KeyCode.Space then
		noclipJumpEndTick = os.clock() + 0.55
	end
	if Cfg.ClickTP and not gp and (inp.UserInputType == Enum.UserInputType.Touch or inp.UserInputType == Enum.UserInputType.MouseButton1) then
		local cam = workspace.CurrentCamera
		local _, _, r = getRig()
		if cam and r then
			local ray = cam:ViewportPointToRay(inp.Position.X, inp.Position.Y)
			local rp = RaycastParams.new()
			rp.FilterType = Enum.RaycastFilterType.Exclude
			local excl = {}
			if LocalPlayer.Character then table.insert(excl, LocalPlayer.Character) end
			if auraWorldFolder then table.insert(excl, auraWorldFolder) end
			if crackRootFolder then table.insert(excl, crackRootFolder) end
			rp.FilterDescendantsInstances = excl
			local hit = workspace:Raycast(ray.Origin, ray.Direction * 1000, rp)
			if hit and hit.Position then
				local rotOnly = r.CFrame - r.Position
				r.AssemblyLinearVelocity = Vector3.zero
				r.CFrame = CFrame.new(hit.Position + Vector3.new(0, 3.2, 0)) * rotOnly
			end
		end
	end
end)

UserInputService.JumpRequest:Connect(function()
	noclipJumpEndTick = os.clock() + 0.55
end)

local function registerPlayer(plr)
	if not joinTimestamps[plr] then joinTimestamps[plr] = os.clock() end
	if plr ~= LocalPlayer then
		showFriendJoinNotify(plr)
		plr.CharacterAdded:Connect(function()
			task.defer(function()
				updateThirdEyeTag(plr)
				syncAllESP()
			end)
		end)
	end
	updateThirdEyeTag(plr)
	syncAllESP()
end

Players.PlayerAdded:Connect(function(plr)
	registerPlayer(plr)
	if pages[2] and pages[2].Visible then rebuildFriendsList() end
	if pages[5] and pages[5].Visible and Cfg.PlayerListOpen then rebuildTrollPlayerList() end
	if pages[6] and pages[6].Visible then rebuildPlayersTimeList() end
end)

Players.PlayerRemoving:Connect(function(plr)
	joinTimestamps[plr] = nil
	friendEspSet[plr] = nil
	targetEspSet[plr] = nil
	clearESP(plr)
	clearThirdEyeTag(plr)
	if spectatedFriend == plr then spectatedFriend = nil end
	if lastMimicTarget == plr then lastMimicTarget = nil; clearMimic() end
end)

LocalPlayer.CharacterAdded:Connect(function(char)
	stopFly()
	releaseHeadSit(char:FindFirstChildOfClass("Humanoid"))
	noclipAnchorY = nil
	noclipJumpEndTick = 0
	airMoveDir = 0
	airWalkWasMoving = false
	if Cfg.AirWalk then airY = nil end
	table.clear(ncStore)
	clearMimic()
	markSelfScriptPresence(char)
	task.defer(function()
		updateThirdEyeTag(LocalPlayer)
		if Cfg.SpectateTarget then resetSpectateCamera() end
		if Cfg.AuraEnabled then
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp then buildAura(char, hrp) end
		end
	end)
end)

if LocalPlayer.Character then markSelfScriptPresence(LocalPlayer.Character) end
for _, plr in ipairs(Players:GetPlayers()) do registerPlayer(plr) end

do
	local lastStatsRefresh = 0
	local lastTimeListRefresh = 0

	RunService.Stepped:Connect(function()
		local char, hum, hrp = getRig()
		if Cfg.Noclip then
			setNoclip(char, hum, true)
			applyNoclipHorizontalLock(char, hum, hrp)
		elseif next(ncStore) ~= nil or (hum and not Cfg.AirWalk) then
			setNoclip(char, hum, false)
		end
		if hum then
			setAntiSit(hum, Cfg.AntiSit)
			if Cfg.AntiSit and not Cfg.HeadSit and (hum.Sit or hum.SeatPart) then
				hum.Sit = false
				hum.SeatPart = nil
				forceUnseatSeatParts(char)
			end
		end
		if Cfg.HeadSit and char and hum and hrp then
			local tgtPlr = findPlayer(getTargetQuery())
			local tgtChar = tgtPlr and tgtPlr.Character
			local tgtRoot = tgtChar and tgtChar:FindFirstChild("HumanoidRootPart")
			local tgtHead = tgtChar and tgtChar:FindFirstChild("Head")
			if tgtRoot then
				headSitActiveLastFrame = true
				applyHeadSitLock(char, hum, hrp, tgtChar, tgtRoot, tgtHead)
			end
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		local now = os.clock()
		local safeDt = math.clamp(dt, 0.001, 0.05)

		if eye1FpsLbl and dt > 0 then
			eye1FpsLbl.Text = tostring(math.clamp(math.floor((1 / dt) + 0.5), 1, 240)) .. " FPS"
		end

		if eye1Pupil then
			eye1Pupil.Position = UDim2.new(0.5 + math.cos(now * 2.0) * 0.14, -2.5, 0.5 + math.sin(now * 1.5) * 0.12, -2.5)
		end
		if topEyePupil then
			topEyePupil.Position = UDim2.new(0.5 + math.cos(now * 2.2) * 0.12, -2, 0.5 + math.sin(now * 1.8) * 0.1, -2)
		end

		if now - lastStatsRefresh >= 0.5 then
			lastStatsRefresh = now
			if topStatsLbl then
				topStatsLbl.Text = "PLAYERS: " .. tostring(#Players:GetPlayers()) .. " | PING: " .. tostring(getPing()) .. "ms"
			end
		end

		for _, plr in ipairs(Players:GetPlayers()) do updateThirdEyeTag(plr) end
		syncAllESP()

		if pages[6] and pages[6].Visible and (now - lastTimeListRefresh >= 1) then
			lastTimeListRefresh = now
			rebuildPlayersTimeList()
		end

		if Cfg.ChatSpam and (now - lastSpamTick >= 1.4) then
			lastSpamTick = now
			sendChatMessage(Cfg.SpamText ~= "" and Cfg.SpamText or "MORTAL On Top!")
		end

		local char, hum, hrp = getRig()
		if not char or not hum or not hrp then return end

		stepAura(now, char, hum, hrp)

		if Cfg.Noclip then
			setNoclip(char, hum, true)
			applyNoclipHorizontalLock(char, hum, hrp)
		end

		if Cfg.AntiSit and not Cfg.HeadSit and (hum.Sit or hum.SeatPart) then
			hum.Sit = false
			hum.SeatPart = nil
			forceUnseatSeatParts(char)
			pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
		end

		local targetSpeed = Cfg.Speed and normalizeMovementSpeed(Cfg.SpeedVal) or 16
		if Cfg.Speed then hum.WalkSpeed = targetSpeed end
		if Cfg.Jump then
			hum.UseJumpPower = true
			hum.JumpPower = normalizeJumpPower(Cfg.JumpVal)
		end

		if Cfg.EmoteSpeed then
			local safeSpd = normalizeEmoteSpeed(Cfg.EmoteVal)
			for _, tr in ipairs(getAllActiveAnimTracks(hum)) do pcall(function() tr:AdjustSpeed(safeSpd) end) end
		end

		if Cfg.AirWalk then
			sanitizeAirWalkAnim(hum)
			enforceAirWalkStates(hum)
			if airY == nil then airY = hrp.Position.Y end
			if airMoveDir ~= 0 then
				airY = airY + (airMoveDir * Cfg.AirStep * math.clamp(dt * 60, 0.25, 2.5))
			end
			local movingNow = hum.MoveDirection.Magnitude > 0.05
			if movingNow then
				airWalkWasMoving = true
				hum.WalkSpeed = targetSpeed
			else
				if airWalkWasMoving then
					airWalkWasMoving = false
					hum.WalkSpeed = 0
					task.defer(function()
						if Cfg.AirWalk and hum and hum.Parent then
							hum.WalkSpeed = Cfg.Speed and targetSpeed or 16
						end
					end)
				end
				hrp.AssemblyLinearVelocity = Vector3.zero
			end
			local pos = hrp.Position
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.CFrame = CFrame.new(pos.X, airY, pos.Z) * (hrp.CFrame - hrp.Position)
		else
			airWalkWasMoving = false
		end

		local tgtPlr = findPlayer(getTargetQuery())
		local tgtChar = tgtPlr and tgtPlr.Character
		local tgtRoot = tgtChar and tgtChar:FindFirstChild("HumanoidRootPart")
		local tgtHead = tgtChar and tgtChar:FindFirstChild("Head")
		local tgtHum = tgtChar and tgtChar:FindFirstChildOfClass("Humanoid")

		if Cfg.SpectateTarget then
			local cam = workspace.CurrentCamera
			if cam and tgtHum then
				if cam.CameraSubject ~= tgtHum or lastSpectatedTargetHum ~= tgtHum then
					pcall(function() cam.CameraSubject = tgtHum end)
					lastSpectatedTargetHum = tgtHum
				end
			elseif lastSpectatedTargetHum ~= nil then
				resetSpectateCamera()
			end
		elseif lastSpectatedTargetHum ~= nil then
			resetSpectateCamera()
		end

		if Cfg.Mimic and tgtPlr then
			runMimic(char, hum, tgtPlr)
		elseif next(mimicTracks) ~= nil then
			clearMimic()
		end

		local didHeadSit = false

		if tgtRoot then
			local hRatio = getAvatarHeightRatio(tgtChar, tgtHead)
			local lookDir = tgtRoot.CFrame.LookVector
			local flatLook = Vector3.new(lookDir.X, 0, lookDir.Z)
			flatLook = (flatLook.Magnitude < 1e-4) and Vector3.new(0, 0, -1) or flatLook.Unit

			if Cfg.LoopTP then
				hrp.CFrame = tgtRoot.CFrame * CFrame.new(0, 0, 3)
			elseif Cfg.FollowTarget then
				local gY = raycastAuraGroundY(tgtRoot.Position, tgtRoot.Position.Y)
				local followY = math.min(tgtRoot.Position.Y, gY + (2.5 * getAvatarHeightRatio(char, char:FindFirstChild("Head"))))
				local backPos = tgtRoot.Position - (flatLook * 3.5)
				local goalPos = Vector3.new(backPos.X, followY, backPos.Z)
				local lookTarget = Vector3.new(tgtRoot.Position.X, followY, tgtRoot.Position.Z)
				hrp.CFrame = CFrame.lookAt(hrp.Position:Lerp(goalPos, math.clamp(safeDt * 10, 0, 1)), lookTarget)
			elseif Cfg.Orbit then
				orbitAngle = orbitAngle + (3.5 * safeDt)
				local rad = 5
				local ox = tgtRoot.Position.X + math.cos(orbitAngle) * rad
				local oz = tgtRoot.Position.Z + math.sin(orbitAngle) * rad
				hrp.CFrame = CFrame.new(Vector3.new(ox, tgtRoot.Position.Y, oz), tgtRoot.Position)
			elseif Cfg.HeadSit then
				didHeadSit = true
				headSitActiveLastFrame = true
				applyHeadSitLock(char, hum, hrp, tgtChar, tgtRoot, tgtHead)
			else
				local mode = nil
				local mbSpeed = normalizeMultiBangSpeed(Cfg.MultiBangSpeed)
				if Cfg.MultiBang then
					if now - lastMultiSwitchTick >= (1 / mbSpeed) then
						lastMultiSwitchTick = now
						multiBangIndex = (multiBangIndex % 3) + 1
					end
					mode = (multiBangIndex == 1 and "FaceBang") or (multiBangIndex == 2 and "Bang") or "FrontBang"
				elseif Cfg.FaceBang then mode = "FaceBang"
				elseif Cfg.FrontBang then mode = "FrontBang"
				elseif Cfg.Bang then mode = "Bang" end

				if mode then
					local activeSpeed = (mode == "FaceBang" or Cfg.MultiBang) and mbSpeed or 3.5
					local clampedOsc = math.min(activeSpeed, 40)
					local pulse = math.sin(now * (clampedOsc * 3.2)) * (0.42 * hRatio)
					if mode == "FaceBang" then
						local faceCenter = tgtHead and tgtHead.Position or (tgtRoot.Position + Vector3.new(0, 1.5 * hRatio, 0))
						local headRadius = (tgtHead and math.max(tgtHead.Size.Z, tgtHead.Size.X) * 0.5) or (0.6 * hRatio)
						local posAtFace = faceCenter + (flatLook * (headRadius + (1.05 * hRatio) + pulse))
						hrp.AssemblyLinearVelocity = Vector3.zero
						hrp.AssemblyAngularVelocity = Vector3.zero
						hrp.CFrame = CFrame.lookAt(posAtFace, faceCenter)
					elseif mode == "FrontBang" then
						local frontPos = tgtRoot.Position + (flatLook * (2.2 + pulse))
						hrp.CFrame = CFrame.lookAt(frontPos, Vector3.new(tgtRoot.Position.X, frontPos.Y, tgtRoot.Position.Z))
					else
						hrp.CFrame = tgtRoot.CFrame * CFrame.new(0, 0, 2.2 + pulse)
					end
				end
			end
		end

		if not didHeadSit and headSitActiveLastFrame then releaseHeadSit(hum) end

		if Cfg.Spin then
			local angDelta = math.rad(normalizeSpinSpeed(Cfg.SpinVal) * 6 * safeDt)
			local pos = hrp.Position
			local rotOnly = (hrp.CFrame - pos) * CFrame.Angles(0, angDelta, 0)
			hrp.AssemblyAngularVelocity = Vector3.zero
			hrp.CFrame = CFrame.new(pos) * rotOnly
		end
	end)
end
