local function stopFly()
	Cfg.Fly = false
	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end
	if flyVelocity then
		pcall(function() flyVelocity:Destroy() end)
		flyVelocity = nil
	end
	if flyGyro then
		pcall(function() flyGyro:Destroy() end)
		flyGyro = nil
	end
	local char, hum = getRig()
	restoreCharacterAnims(char)
	if hum then
		pcall(function() hum.PlatformStand = false end)
	end
	if syncFlyUI then
		pcall(syncFlyUI)
	end
end

local function startFly()
	stopFly()
	local char, hum, root = getRig()
	if not hum or not root then return end
	Cfg.Fly = true
	clearAllCharacterAnims(char, hum)
	pcall(function() hum.PlatformStand = true end)
	pcall(function()
		root.CFrame = root.CFrame + Vector3.new(0, 3.5, 0)
	end)
	local vel = Instance.new("BodyVelocity")
	vel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
	vel.Velocity = Vector3.zero
	vel.Parent = root
	flyVelocity = vel

	local gyro = Instance.new("BodyGyro")
	gyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
	gyro.P = 1e4
	gyro.Parent = root
	flyGyro = gyro

	if syncFlyUI then
		pcall(syncFlyUI)
	end

	flyConnection = RunService.RenderStepped:Connect(function(dt)
		if not Cfg.Fly or not root or not root.Parent then
			stopFly()
			return
		end
		local camera = workspace.CurrentCamera
		local move = hum.MoveDirection
		local rawSpd = tonumber(Cfg.FlyVal)
		local spd = (rawSpd and rawSpd == rawSpd) and rawSpd or 50
		if hum then
			pcall(function()
				local animator = hum:FindFirstChildOfClass("Animator")
				if animator then
					for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
						tr:Stop(0)
					end
				end
			end)
		end
		local desiredVel = Vector3.zero
		if move.Magnitude > 0.05 and camera then
			local camCF = camera.CFrame
			local camLook = camCF.LookVector
			local camRight = camCF.RightVector
			local horizRight = Vector3.new(camRight.X, 0, camRight.Z)
			if horizRight.Magnitude > 1e-4 then
				horizRight = horizRight.Unit
			end
			local flatLook = Vector3.new(camLook.X, 0, camLook.Z)
			local forwardAmt = 0
			if flatLook.Magnitude > 1e-4 then
				forwardAmt = move:Dot(flatLook.Unit)
			else
				forwardAmt = move.Magnitude
			end
			local rightAmt = move:Dot(horizRight)
			local aimDir = (camLook * forwardAmt) + (horizRight * rightAmt)
			if aimDir.Magnitude > 1e-4 then
				desiredVel = aimDir.Unit * math.clamp(move.Magnitude, 0, 1) * spd
			else
				desiredVel = move.Unit * spd
			end
		elseif move.Magnitude > 0.05 then
			desiredVel = move.Unit * spd
		end
		vel.Velocity = desiredVel
		root.AssemblyLinearVelocity = desiredVel
		if desiredVel.Magnitude > 0.05 then
			root.CFrame = root.CFrame + (desiredVel * dt)
		end
		if camera then
			gyro.CFrame = camera.CFrame
		end
	end)
end

local function setFlyState(on)
	if on then
		startFly()
	else
		stopFly()
	end
end

