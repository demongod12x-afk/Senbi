	eWhite.BackgroundColor3 = Color3.fromRGB(240, 228, 255)
	eWhite.BorderSizePixel = 0
	eWhite.ZIndex = zBase
	eWhite.Parent = parentFrame
	Instance.new("UICorner", eWhite).CornerRadius = UDim.new(1, 0)
	addBorder(eWhite, NEON_RIFT, 1.3, 0.08)

	local eIris = Instance.new("Frame")
	eIris.Size = UDim2.new(0, irisSize, 0, irisSize)
	eIris.Position = UDim2.new(0.5, -irisSize * 0.5, 0.5, -irisSize * 0.5)
	eIris.BackgroundColor3 = BTN_ON
	eIris.BorderSizePixel = 0
	eIris.ZIndex = zBase + 1
	eIris.Parent = eWhite
	Instance.new("UICorner", eIris).CornerRadius = UDim.new(1, 0)

