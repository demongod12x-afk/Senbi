	UI.joinBanner = Instance.new("Frame")
	UI.joinBanner.Name = "MortalFriendJoinBanner"
	UI.joinBanner.Size = UDim2.new(0, 272, 0, 48)
	UI.joinBanner.Position = UDim2.new(0.5, -136, 0, 14)
	UI.joinBanner.BackgroundColor3 = TAG_DARK_BAR
	UI.joinBanner.Active = true
	UI.joinBanner.Visible = false
	UI.joinBanner.ZIndex = 65
	UI.joinBanner.Parent = sg
	Instance.new("UICorner", UI.joinBanner).CornerRadius = UDim.new(0, 10)
	addBorder(UI.joinBanner, NEON_RIFT, 1.6, 0.08)

