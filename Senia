local function findPlayer(query)
	if not query then return nil end
	local q = string.lower((tostring(query):gsub("^%s+", ""):gsub("%s+$", "")))
	if q == "" then return nil end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local u = string.lower(plr.Name)
			local d = string.lower(plr.DisplayName or "")
			if u == q or d == q or string.find(u, q, 1, true) or (d ~= "" and string.find(d, q, 1, true)) then
				return plr
			end
		end
	end
	return nil
end

local function getPing()
	local ms = 0
	if Stats then
		pcall(function()
			local net = Stats.Network and Stats.Network:FindFirstChild("ServerStatsItem")
			local dp = net and net:FindFirstChild("Data Ping")
			if dp and type(dp.GetValue) == "function" then
				ms = math.floor(dp:GetValue())
			end
		end)
	end
	if ms == 0 and LocalPlayer then
		pcall(function()
			if LocalPlayer.GetNetworkPing then
				ms = math.floor(LocalPlayer:GetNetworkPing() * 1000)
			end
		end)
	end
	return ms
end

