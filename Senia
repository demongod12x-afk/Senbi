local function findPlayer(query)
	if not query then return nil end
	local q = string.lower((tostring(query):gsub("^%s+", ""):gsub("%s+$", "")))
	if q == "" then return nil end
	local partialList = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local u = string.lower(plr.Name)
			local d = string.lower(plr.DisplayName or "")
			if u == q or d == q then return plr end
			table.insert(partialList, { plr = plr, u = u, d = d })
		end
	end
	for _, entry in ipairs(partialList) do
		if string.sub(entry.u, 1, #q) == q or (entry.d ~= "" and string.sub(entry.d, 1, #q) == q) then
			return entry.plr
		end
	end
	for _, entry in ipairs(partialList) do
		if string.find(entry.u, q, 1, true) or (entry.d ~= "" and string.find(entry.d, q, 1, true)) then
			return entry.plr
		end
	end
	return nil
end

local function getAvatarHeightRatio(char, head)
	local h = 5.0
	if char then
		local okExt, extSize = pcall(function() return char:GetExtentsSize() end)
		if okExt and typeof(extSize) == "Vector3" and extSize.Y > 1 then
			h = extSize.Y
		elseif head and head:IsA("BasePart") then
			h = math.max(2.5, head.Size.Y * 4.2)
		end
	end
	return math.clamp(h / 5.0, 0.55, 2.6)
end

local function formatDuration(sec)
	local s = math.max(0, math.floor(sec))
	local h = math.floor(s / 3600)
	local m = math.floor((s % 3600) / 60)
	local r = s % 60
	if h > 0 then return string.format("%dh %dm %ds", h, m, r)
	elseif m > 0 then return string.format("%dm %ds", m, r)
	else return string.format("%ds", r) end
end

