-- MAIN RUNTIME LOOP (Movement, Anti-Sit, Noclip, Target, Aura)
-- ==========================================
local bangPhase = 0
local lastSavedWalkSpeed = nil
local lastSavedJumpPower = nil

RunService.RenderStepped:Connect(function(dt)
	local now = os.clock()
	local char, hum, hrp, head = getRig()
	if not char or not hum or hum.Health <= 0 or not hrp then
		cleanupFly()
		cleanupAirWalk()
		AuraSystem.Step(now, nil, nil, nil)
		return
	end

	-- Save baseline walkspeed/jumppower once
	if lastSavedWalkSpeed == nil then
		lastSavedWalkSpeed = hum.WalkSpeed
	end
	if lastSavedJumpPower == nil then
		lastSavedJumpPower = hum.UseJumpPower and hum.JumpPower or hum.JumpHeight
	end

	-- Anti-Sit (Never kills animations; prevents sitting on seats/benches)
	if State.AntiSitEnabled then
		if hum.Sit then
			hum.Sit = false
		end
		if hum.SeatPart then
			hum.SeatPart = nil
		end
		for _, desc in ipairs(char:GetDescendants()) do
			if desc:IsA("Weld") and desc.Name == "SeatWeld" then
				pcall(function() desc:Destroy() end)
			end
		end
	end

	-- WalkSpeed & JumpPower
	if State.SpeedEnabled then
		local spd = parseSafeNumber(State.SpeedValue, 50, 0, 1000000)
		hum.WalkSpeed = spd
		-- Keep forward momentum smoothly when joystick is released while moving fast
		if hum.MoveDirection.Magnitude > 0.05 then
			local dir = Vector3.new(hum.MoveDirection.X, 0, hum.MoveDirection.Z).Unit
			hrp.AssemblyLinearVelocity = Vector3.new(dir.X * spd, hrp.AssemblyLinearVelocity.Y, dir.Z * spd)
		elseif State.AirWalkEnabled and hrp.AssemblyLinearVelocity.Magnitude > 1 then
			-- Smoothly decay horizontal velocity without freezing mid-air
			local hv = Vector3.new(hrp.AssemblyLinearVelocity.X * 0.86, hrp.AssemblyLinearVelocity.Y, hrp.AssemblyLinearVelocity.Z * 0.86)
			hrp.AssemblyLinearVelocity = hv
		end
	elseif lastSavedWalkSpeed then
		if hum.WalkSpeed ~= lastSavedWalkSpeed and not State.SpeedEnabled then
			-- Restore cleanly when toggled off
		end
	end

	if State.JumpEnabled then
		local jmp = parseSafeNumber(State.JumpValue, 50, 0, 1000000)
		hum.UseJumpPower = true
		hum.JumpPower = jmp
	end

	-- Air Walk (Keeps platform underneath smoothly; never freezes character on stop)
	if State.AirWalkEnabled then
		local plat = ensureAirWalkPart()
		if airWalkY == nil then
			airWalkY = hrp.Position.Y - 3.25
		end
		-- Allow controlled jump rise or drop
		if hum.MoveDirection.Magnitude > 0.05 and hrp.AssemblyLinearVelocity.Y < -0.5 then
			-- Maintain smooth hover height without sudden freeze
			hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, math.max(hrp.AssemblyLinearVelocity.Y, -8), hrp.AssemblyLinearVelocity.Z)
		end
		plat.CFrame = CFrame.new(hrp.Position.X, airWalkY, hrp.Position.Z)
	else
		cleanupAirWalk()
	end

	-- Fly
	if State.FlyEnabled then
		if not flyBodyVel or flyBodyVel.Parent ~= hrp then
			cleanupFly()
			flyBodyVel = Instance.new("BodyVelocity")
			flyBodyVel.MaxForce = Vector3.new(1e7, 1e7, 1e7)
			flyBodyVel.Velocity = Vector3.zero
			flyBodyVel.Parent = hrp

			flyBodyGyro = Instance.new("BodyGyro")
			flyBodyGyro.MaxTorque = Vector3.new(1e7, 1e7, 1e7)
			flyBodyGyro.P = 15000
			flyBodyGyro.CFrame = hrp.CFrame
			flyBodyGyro.Parent = hrp
		end
		local spd = parseSafeNumber(State.FlyValue, 50, 0, 1000000)
		local cam = workspace.CurrentCamera
		local moveDir = hum.MoveDirection
		local vel = Vector3.zero
		if moveDir.Magnitude > 0.05 and cam then
			local look = cam.CFrame.LookVector
			local right = cam.CFrame.RightVector
			local flatLook = Vector3.new(look.X, 0, look.Z)
			local flatRight = Vector3.new(right.X, 0, right.Z)
			if flatLook.Magnitude > 0.01 then flatLook = flatLook.Unit end
			if flatRight.Magnitude > 0.01 then flatRight = flatRight.Unit end
			local forwardAmt = flatLook:Dot(moveDir)
			local rightAmt = flatRight:Dot(moveDir)
			local flyVec = (cam.CFrame.LookVector * forwardAmt + flatRight * rightAmt)
			if flyVec.Magnitude > 0.01 then
				vel = flyVec.Unit * spd
			end
		end
		flyBodyVel.Velocity = vel
		if cam then
			flyBodyGyro.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + cam.CFrame.LookVector)
		end
	else
		cleanupFly()
	end

	-- Noclip (Prevents sudden jump onto upper building floors/roofs)
	if State.NoclipEnabled then
		if not wasNoclipping or lastNoclipY == nil then
			lastNoclipY = hrp.Position.Y
			wasNoclipping = true
		end
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
		-- Prevent upward roof/floor snap when moving horizontally against walls
		local horizSpeed = Vector3.new(hrp.AssemblyLinearVelocity.X, 0, hrp.AssemblyLinearVelocity.Z).Magnitude
		if horizSpeed > 1 and hrp.Position.Y > lastNoclipY + 2.2 and hum.FloorMaterial == Enum.Material.Air then
			hrp.CFrame = CFrame.new(hrp.Position.X, lastNoclipY, hrp.Position.Z) * hrp.CFrame.Rotation
			hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, math.min(0, hrp.AssemblyLinearVelocity.Y), hrp.AssemblyLinearVelocity.Z)
		else
			lastNoclipY = hrp.Position.Y
		end
	else
		wasNoclipping = false
		lastNoclipY = nil
	end

	-- Target Actions (Face Bang, Mimic, Follow Target)
	if State.SelectedTarget and State.SelectedTarget.Parent then
		local tChar, tHum, tHrp, tHead = getTargetRig(State.SelectedTarget)
		if tChar and tHum and tHrp then
			-- Face Bang: Turn toward target and bang right at target's face/head height
			if State.FaceBangEnabled then
				local multi = parseSafeNumber(State.MultiBangValue, 5, 1, 1000000)
				bangPhase += dt * math.clamp(8 + multi * 2.5, 8, 80)
				local facePos = tHead and tHead.Position or (tHrp.Position + Vector3.new(0, 1.6, 0))
				local toTargetFlat = Vector3.new(tHrp.Position.X - hrp.Position.X, 0, tHrp.Position.Z - hrp.Position.Z)
				local lookDir = (toTargetFlat.Magnitude > 0.05) and toTargetFlat.Unit or (-tHrp.CFrame.LookVector)

				local osc = math.sin(bangPhase) * 0.65
				-- Position right in front of target's face at target's face height
				local bangSpot = Vector3.new(
					facePos.X - lookDir.X * (1.35 + osc),
					facePos.Y - 0.35,
					facePos.Z - lookDir.Z * (1.35 + osc)
				)
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.CFrame = CFrame.lookAt(bangSpot, Vector3.new(facePos.X, facePos.Y - 0.35, facePos.Z))
			end

			-- Follow Target (Grounded on ground Y, never floating in air)
			if State.FollowTargetEnabled and not State.FaceBangEnabled then
				local offsetPos = tHrp.Position - (tHrp.CFrame.LookVector * 3.5)
				local gY, foundGround = raycastGroundY(offsetPos, offsetPos.Y)
				local desiredPos = foundGround and Vector3.new(offsetPos.X, gY + 3.0, offsetPos.Z) or Vector3.new(offsetPos.X, hrp.Position.Y, offsetPos.Z)
				local toGoal = desiredPos - hrp.Position
				if toGoal.Magnitude > 1.2 then
					local flatGoal = Vector3.new(toGoal.X, 0, toGoal.Z)
					if flatGoal.Magnitude > 0.05 then
						hum:MoveTo(Vector3.new(desiredPos.X, gY, desiredPos.Z))
					end
				end
			end

			-- Mimic Target movements & animations smoothly
			if State.MimicEnabled and not State.FaceBangEnabled then
				if tHum.MoveDirection.Magnitude > 0.05 then
					hum:Move(tHum.MoveDirection, false)
				else
					hum:Move(Vector3.zero, false)
				end
				if tHum.Jump then
					hum.Jump = true
				end
				local myAnim = hum:FindFirstChildOfClass("Animator")
				local theirAnim = tHum:FindFirstChildOfClass("Animator")
				if myAnim and theirAnim then
					for _, track in ipairs(theirAnim:GetPlayingAnimationTracks()) do
						if track.Animation and track.Animation.AnimationId ~= "" then
							local alreadyPlaying = false
							for _, mTrack in ipairs(myAnim:GetPlayingAnimationTracks()) do
								if mTrack.Animation and mTrack.Animation.AnimationId == track.Animation.AnimationId then
									alreadyPlaying = true
									break
								end
							end
							if not alreadyPlaying then
								pcall(function()
									local loaded = myAnim:LoadAnimation(track.Animation)
									loaded:Play(0.1, track.WeightCurrent, track.Speed)
								end)
							end
						end
					end
				end
			end
		end
	end

	-- Emote Speed
	if State.EmoteSpeedEnabled then
		local eSpd = parseSafeNumber(State.EmoteSpeedValue, 1, 0.1, 1000000)
		local animator = hum:FindFirstChildOfClass("Animator")
		if animator then
			for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
				track:AdjustSpeed(eSpd)
			end
		end
	end

	-- Spin (Stable Y-axis rotation only; never flings or teleports into the sky)
	if State.SpinEnabled then
		local rawSpn = parseSafeNumber(State.SpinValue, 25, -1000000, 1000000)
		-- Cap angular step per frame safely so huge numbers never fling character or cause NaN
		local degPerSec = math.clamp(rawSpn * 18, -7200, 7200)
		spinAngle = (spinAngle + math.rad(degPerSec) * dt) % (math.pi * 2)
		local pos = hrp.Position
		local flatLook = hrp.CFrame.LookVector
		local baseYaw = math.atan2(-flatLook.X, -flatLook.Z)
		hrp.CFrame = CFrame.new(pos) * CFrame.Angles(0, baseYaw + spinAngle, 0)
	else
		spinAngle = 0
	end

	-- Aura Step
	AuraSystem.Step(now, char, hum, hrp)
end)

-- Respawn cleanup
LocalPlayer.CharacterAdded:Connect(function()
	cleanupFly()
	cleanupAirWalk()
	lastNoclipY = nil
	wasNoclipping = false
	AuraSystem.Clear()
	task.wait(0.2)
	updateEsp()
	local char, _, hrp = getRig()
	if State.AuraEnabled and char and hrp then
		buildAura(char, hrp)
	end
end)

updateEsp()
refreshAuraEyeButtons()
