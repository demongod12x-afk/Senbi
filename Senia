local function updateThirdEyeTag(plr)
	if not isVerifiedMortalUser(plr) then
		clearThirdEyeTag(plr)
		return
	end
	local pChar = plr.Character
	local head = pChar and pChar:FindFirstChild("Head")
	if not pChar or not head then
		clearThirdEyeTag(plr)
		return
	end
	local entry = thirdEyeTagStore[plr]
	if not entry or entry.Char ~= pChar or not entry.Billboard or not entry.Billboard.Parent then
		clearThirdEyeTag(plr)
		pcall(function()
			local dispName = plr.DisplayName
			local barW = math.clamp(#dispName * 7.2 + 40, 108, 175)
			local bb = Instance.new("BillboardGui")
			bb.Name = "MortalMemberTag"
			bb.Size = UDim2.new(0, barW, 0, 24)
			bb.StudsOffset = Vector3.new(0, 2.8, 0)
			bb.AlwaysOnTop = true
			bb.MaxDistance = math.huge
			bb.Parent = head

			local bar = Instance.new("Frame")
			bar.Size = UDim2.new(1, 0, 1, 0)
			bar.BackgroundColor3 = TAG_DARK_BAR
			bar.BackgroundTransparency = 0.04
			bar.BorderSizePixel = 0
			bar.Parent = bb
			Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 8)
			addBorder(bar, TAG_NEON_OUTLINE, 1.7, 0.05)

			local lay = Instance.new("UIListLayout")
			lay.FillDirection = Enum.FillDirection.Horizontal
			lay.HorizontalAlignment = Enum.HorizontalAlignment.Center
			lay.VerticalAlignment = Enum.VerticalAlignment.Center
			lay.Padding = UDim.new(0, 4)
			lay.Parent = bar

			local eyeHolder = Instance.new("Frame")
			eyeHolder.Size = UDim2.new(0, 20, 0, 14)
			eyeHolder.BackgroundTransparency = 1
			eyeHolder.Parent = bar
			local pupil = createEyeGraphic(eyeHolder, 18, 11, 7, 3, 5)

			local lbl = Instance.new("TextLabel")
			lbl.Size = UDim2.new(0, barW - 30, 1, 0)
			lbl.BackgroundTransparency = 1
			lbl.Font = Enum.Font.GothamBlack
			lbl.TextSize = 11
			lbl.TextScaled = true
			lbl.Text = dispName
			lbl.TextColor3 = TAG_NEON_PURPLE
			lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
			lbl.TextStrokeTransparency = 0
			lbl.Parent = bar

			entry = { Char = pChar, Billboard = bb, Pupil = pupil }
			thirdEyeTagStore[plr] = entry
		end)
	end

	if entry and entry.Billboard then
		-- Hide only on the local client for LocalPlayer when SelfTagVisible is OFF;
		-- other players/script users are untouched.
		if plr == LocalPlayer then
			entry.Billboard.Enabled = (Cfg.SelfTagVisible == true)
		else
			entry.Billboard.Enabled = true
		end
	end

	if entry and entry.Pupil and entry.Billboard and entry.Billboard.Enabled then
		local t = os.clock()
		entry.Pupil.Position = UDim2.new(0.5 + math.cos(t * 2.2) * 0.12, -1.5, 0.5 + math.sin(t * 1.7) * 0.1, -1.5)
	end
end

local function clearESP(plr)
	if espStore[plr] then
		pcall(function()
			if espStore[plr].Highlight then espStore[plr].Highlight:Destroy() end
			if espStore[plr].Billboard then espStore[plr].Billboard:Destroy() end
		end)
		espStore[plr] = nil
	end
end

local function getDistanceMeters(plr)
	local _, _, myR = getRig()
	local tChar = plr and plr.Character
	local tR = tChar and (tChar:FindFirstChild("HumanoidRootPart") or tChar:FindFirstChild("Head"))
	if myR and tR then
		return math.floor((myR.Position - tR.Position).Magnitude + 0.5)
	end
	return nil
end

