local function spawnWalkCrack(item, groundPos, moveDir, scale)
	local node = Instance.new("Folder")
	node.Name = "WalkCrackNode"
	node.Parent = item.crackFolder
	local segs = {}
	for b = 1, 5 do
		local ang = math.atan2(moveDir.Z, moveDir.X) + (((b - 3) / 2.5) * 1.45)
		local cur = groundPos
		local segLen = 0.72 * scale
		for s = 1, 3 do
			ang = ang + (((s % 2 == 0) and 1 or -1) * 0.52)
			local nxt = cur + Vector3.new(math.cos(ang), 0, math.sin(ang)) * segLen
			table.insert(segs, createCrackSeg(node, cur, nxt, 0.25 * scale, false))
			cur = nxt
		end
	end
	local popup = createRiftPopup(node, scale)
	table.insert(item.walkCracks, {
		folder = node, segs = segs, popup = popup,
		originPos = groundPos, spawnTime = os.clock(), duration = 2.2
	})
	if #item.walkCracks > 14 then
		local old = table.remove(item.walkCracks, 1)
		pcall(function() old.folder:Destroy() end)
	end
end

local function spawnLandingMegaCrack(item, groundPos, scale)
	local node = Instance.new("Folder")
	node.Name = "LandingMegaCrackNode"
	node.Parent = item.crackFolder
	local segs = {}
	local armCount = 14
	local reach = 9.5 * scale
	for i = 1, armCount do
		local baseAng = ((i - 1) / armCount) * math.pi * 2
		local cur = groundPos
		local ang = baseAng
		for s = 1, 4 do
			ang = ang + (((s % 2 == 0) and 1 or -1) * 0.40)
			local nxt = cur + Vector3.new(math.cos(ang), 0, math.sin(ang)) * (reach / 4)
			table.insert(segs, createCrackSeg(node, cur, nxt, 0.38 * scale, true))
			cur = nxt
		end
	end
	local popup = createRiftPopup(node, scale * 1.25)
	table.insert(item.landingCracks, {
		folder = node, segs = segs, popup = popup,
		originPos = groundPos, spawnTime = os.clock(), duration = 3.0
	})
	if #item.landingCracks > 6 then
		local old = table.remove(item.landingCracks, 1)
		pcall(function() old.folder:Destroy() end)
	end
end

function AuraSystem.Step(now, char, hum, hrp)
	if not State.AuraEnabled or not char or not hum or hum.Health <= 0 or not hrp then
		if builtKey ~= nil then AuraSystem.Clear() end
		return
	end

	local spreadFlag = State.UltimateSpread and "1" or "0"
	local desiredKey = tostring(char) .. "_" .. tostring(State.SelectedAura) .. "_" .. tostring(State.AuraLevel) .. "_" .. spreadFlag
	if builtKey ~= desiredKey or not auraFolder or auraFolder.Parent ~= char then
		buildAura(char, hrp)
	end

	local tier = getTier()
	local spreadMult = State.UltimateSpread and 2.2 or 1.0

	for _, item in ipairs(activeAuraItems) do
		if item.kind == "star_radiance_burst" then
			local vel = hrp.AssemblyLinearVelocity
			local horizVel = Vector3.new(vel.X, 0, vel.Z)
			local wakeOffset = (horizVel.Magnitude > 0.6)
				and (-horizVel.Unit * math.clamp(horizVel.Magnitude / 16, 0, 1) * (4.5 * (item.avatarScale or 1) * tier.reachMult * spreadMult))
				or Vector3.zero

			local burstTick = math.floor(now * (4.2 * tier.speedMult))
			local emitNow = (burstTick ~= item.lastBurstTick)
			if emitNow then item.lastBurstTick = burstTick end

			local sMult = tier.sizeMult * item.fixedScale * (State.UltimateSpread and 1.35 or 1.0)
			for idx, pe in ipairs(item.emitters) do
				local baseMin = (idx % 2 == 1) and 0.65 or 0.60
				local baseMid = (idx % 2 == 1) and 1.55 or 1.45
				pe.Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, baseMin * sMult),
					NumberSequenceKeypoint.new(0.55, baseMid * sMult),
					NumberSequenceKeypoint.new(1, 0),
				})
				pe.Speed = NumberRange.new(4.5 * tier.speedMult * spreadMult, 11.5 * tier.speedMult * spreadMult)
				local baseSpread = (idx % 2 == 1) and 135 or 170
				local clampedSpread = math.clamp(baseSpread * tier.spreadMult * spreadMult, 50, 180)
				pe.SpreadAngle = Vector2.new(clampedSpread, clampedSpread)
				pe.Acceleration = Vector3.new(wakeOffset.X * 5.0, (idx % 2 == 1) and 6.0 or 4.0, wakeOffset.Z * 5.0)
				if emitNow then
					pe:Emit(math.max(2, math.floor((tier.burst * spreadMult) / math.max(1, #item.emitters))))
				end
			end
			if item.light then
				item.light.Range = tier.lightRange * spreadMult
				item.light.Brightness = tier.lightBright + math.sin(now * 6) * 0.25
			end
		elseif item.kind == "surge" then
			local sMult = tier.sizeMult * item.fixedScale * (State.UltimateSpread and 1.45 or 1.0)
			for _, pe in ipairs(item.emitters) do
				pe.Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.5 * sMult),
					NumberSequenceKeypoint.new(0.5, 1.85 * sMult),
					NumberSequenceKeypoint.new(1, 0),
				})
				pe.Speed = NumberRange.new(8 * tier.speedMult * spreadMult, 22 * tier.speedMult * spreadMult)
				local sp = math.clamp(120 * tier.spreadMult * spreadMult, 40, 180)
				pe.SpreadAngle = Vector2.new(sp, sp)
			end
			if now - lastSurgeEmit >= math.max(0.08, 0.28 / tier.speedMult) then
				lastSurgeEmit = now
				for _, pe in ipairs(item.emitters) do
					pe:Emit(math.max(3, math.floor((tier.burst * 0.5 * spreadMult) / math.max(1, #item.emitters))))
				end
			end
			if item.light then
				item.light.Range = tier.lightRange * spreadMult
				item.light.Brightness = tier.lightBright * (1 + State.AuraLevel * 0.25) + math.sin(now * 9) * 0.35
			end
		elseif item.kind == "smoke" then
			local sMult = tier.sizeMult * item.fixedScale * (State.UltimateSpread and 1.65 or 1.0)
			for _, pe in ipairs(item.emitters) do
				pe.Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.9 * sMult),
					NumberSequenceKeypoint.new(0.5, 2.7 * sMult),
					NumberSequenceKeypoint.new(1, 4.2 * sMult),
				})
				pe.Speed = NumberRange.new(3.5 * tier.speedMult * spreadMult, 11 * tier.speedMult * spreadMult)
				local sp = math.clamp(140 * tier.spreadMult * spreadMult, 45, 180)
				pe.SpreadAngle = Vector2.new(sp, sp)
			end
			if now - lastSmokeEmit >= math.max(0.12, 0.35 / tier.speedMult) then
				lastSmokeEmit = now
				for _, pe in ipairs(item.emitters) do
					pe:Emit(math.max(2, math.floor((tier.burst * 0.35 * spreadMult) / math.max(1, #item.emitters))))
				end
			end
			if item.light then
				item.light.Range = tier.lightRange * spreadMult
				item.light.Brightness = tier.lightBright * 0.85
			end
		elseif item.kind == "mortals_neverdie" then
			local airborne = (hum.FloorMaterial == Enum.Material.Air) and (hrp.AssemblyLinearVelocity.Y < -2)
			local gY, grounded = raycastGroundY(hrp.Position, hrp.Position.Y - 3)
			local groundPos = Vector3.new(hrp.Position.X, gY, hrp.Position.Z)

			if airborne then
				wasAirborne = true
			elseif wasAirborne and grounded then
				wasAirborne = false
				spawnLandingMegaCrack(item, groundPos, item.fixedScale * tier.sizeMult * (State.UltimateSpread and 1.3 or 1.0))
			end

			local horizVel = Vector3.new(hrp.AssemblyLinearVelocity.X, 0, hrp.AssemblyLinearVelocity.Z)
			if not airborne and grounded and horizVel.Magnitude > 2.5 then
				if not lastWalkCrackPos or (groundPos - lastWalkCrackPos).Magnitude >= (2.8 / tier.speedMult) then
					lastWalkCrackPos = groundPos
					local mDir = (hum.MoveDirection.Magnitude > 0.1) and hum.MoveDirection.Unit or horizVel.Unit
					spawnWalkCrack(item, groundPos, mDir, item.fixedScale * tier.sizeMult)
				end
			end

			local function updateList(list)
				for i = #list, 1, -1 do
					local c = list[i]
					local age = now - c.spawnTime
					if age >= c.duration then
						pcall(function() c.folder:Destroy() end)
						table.remove(list, i)
					else
						for _, seg in ipairs(c.segs) do updateCrackSeg(seg) end
						if c.popup and c.popup.holder then
							c.popup.holder.CFrame = CFrame.new(c.originPos + Vector3.new(0, 1.4 + age * 1.1, 0))
							local fade = math.clamp((age - c.duration * 0.65) / (c.duration * 0.35), 0, 1)
							c.popup.label.TextTransparency = fade
							c.popup.label.TextStrokeTransparency = fade
						end
					end
				end
			end
			updateList(item.walkCracks)
			updateList(item.landingCracks)
			if item.light then
				item.light.Range = tier.lightRange * spreadMult
				item.light.Brightness = tier.lightBright + math.sin(now * 5) * 0.2
			end
		end
	end
end

