	UI.joinBannerLbl.Size = UDim2.new(1, -16, 1, -6)
	UI.joinBannerLbl.Position = UDim2.new(0, 8, 0, 3)
	UI.joinBannerLbl.BackgroundTransparency = 1
	UI.joinBannerLbl.Font = Enum.Font.GothamBlack
	UI.joinBannerLbl.TextSize = 10
	UI.joinBannerLbl.TextColor3 = TAG_NEON_PURPLE
	UI.joinBannerLbl.TextWrapped = true
	UI.joinBannerLbl.ZIndex = 66
	UI.joinBannerLbl.Parent = UI.joinBanner

	UI.bannerToken = 0
	UI.swipeStartY = nil
	UI.bannerBaseY = 14

	local function dismissBannerUp()
		UI.bannerToken = UI.bannerToken + 1
		UI.swipeStartY = nil
		UI.joinBanner.Position = UDim2.new(0.5, -136, 0, -64)
		UI.joinBanner.Visible = false
	end

	UI.joinBanner.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.Touch or inp.UserInputType == Enum.UserInputType.MouseButton1 then
			UI.swipeStartY = inp.Position.Y
		end
	end)
	UI.joinBanner.InputChanged:Connect(function(inp)
		if not UI.joinBanner.Visible or UI.swipeStartY == nil then return end
		if inp.UserInputType == Enum.UserInputType.Touch or inp.UserInputType == Enum.UserInputType.MouseMovement then
			local dy = inp.Position.Y - UI.swipeStartY
			if dy < 0 then
				UI.joinBanner.Position = UDim2.new(0.5, -136, 0, UI.bannerBaseY + dy)
				if dy <= -24 then dismissBannerUp() end
			end
		end
	end)
	UI.joinBanner.InputEnded:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.Touch or inp.UserInputType == Enum.UserInputType.MouseButton1 then
			if UI.joinBanner.Visible and UI.swipeStartY ~= nil then
				UI.joinBanner.Position = UDim2.new(0.5, -136, 0, UI.bannerBaseY)
			end
			UI.swipeStartY = nil
		end
	end)

	showFriendJoinNotify = function(plr)
		if not plr or notifiedFriends[plr.UserId] or not isFriend(plr) then return end
		notifiedFriends[plr.UserId] = true
		UI.bannerToken = UI.bannerToken + 1
		local myToken = UI.bannerToken
		UI.swipeStartY = nil
		UI.joinBannerLbl.Text = "FRIEND JOINED: " .. plr.DisplayName .. " (@" .. plr.Name .. ")\nSwipe UP to dismiss"
		UI.joinBanner.Position = UDim2.new(0.5, -136, 0, UI.bannerBaseY)
		UI.joinBanner.Visible = true
		playClick(1.25)
		task.delay(5.0, function()
			if UI.bannerToken == myToken and UI.joinBanner and UI.joinBanner.Parent then
				dismissBannerUp()
			end
		end)
	end
end

