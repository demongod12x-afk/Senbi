			auraUltimateBtn.BackgroundColor3 = Cfg.UltimateSpread and BTN_ON or BTN_OFF
		end
		local colorTag = Cfg.AuraCustomColor
			and string.format("H:%d S:%d%% V:%d%%", math.floor(Cfg.AuraHue * 360), math.floor(Cfg.AuraSat * 100), math.floor(Cfg.AuraVal * 100))
			or "PURPLE"
		if auraColorStatusLbl then
			auraColorStatusLbl.Text = "AURA COLOR: " .. colorTag .. " (SAVED)"
		end
		wheelPreviewBox.BackgroundColor3 = picked
		wheelPickerDot.BackgroundColor3 = picked
		wheelShadeBox.BackgroundColor3 = Color3.fromHSV(Cfg.AuraHue, 1, 1)
		wheelPreviewInfo.Text = colorTag .. " | TAP OR DRAG"
		local dotX = math.clamp(Cfg.AuraSat, 0, 1)
		local dotY = math.clamp((1 - Cfg.AuraVal) / 0.82, 0, 1)
		wheelPickerDot.Position = UDim2.new(dotX, -7, dotY, -7)
		local angleRad = (Cfg.AuraHue * math.pi * 2) - (math.pi / 2)
		local ringX = 0.5 + math.cos(angleRad) * 0.425
		local ringY = 0.5 + math.sin(angleRad) * 0.425
		wheelRingDot.Position = UDim2.new(ringX, -7, ringY, -7)
		wheelRingDot.BackgroundColor3 = Color3.fromHSV(Cfg.AuraHue, 1, 1)
	end

	local wheelDragTarget = nil
	local function updateAuraHueFromPos(posX, posY)
		local cPos = wheelOuterCircle.AbsolutePosition
		local cSize = wheelOuterCircle.AbsoluteSize
		if cSize.X <= 1 or cSize.Y <= 1 then return end
		local dx = posX - (cPos.X + cSize.X * 0.5)
		local dy = posY - (cPos.Y + cSize.Y * 0.5)
		local angle = math.atan2(dy, dx) + (math.pi / 2)
		if angle < 0 then angle = angle + (math.pi * 2) end
		Cfg.AuraCustomColor = true
		Cfg.AuraHue = math.clamp(angle / (math.pi * 2), 0, 1)
		applyLiveAuraColorOnly()
		refreshAuraUI()
		scheduleAuraSave(0.18)
	end

	local function updateAuraShadeFromPos(posX, posY)
		local bPos = wheelShadeBox.AbsolutePosition
		local bSize = wheelShadeBox.AbsoluteSize
		if bSize.X <= 1 or bSize.Y <= 1 then return end
		local nx = math.clamp((posX - bPos.X) / bSize.X, 0, 1)
		local ny = math.clamp((posY - bPos.Y) / bSize.Y, 0, 1)
		Cfg.AuraCustomColor = true
		Cfg.AuraSat = math.clamp(nx, 0.02, 1)
		Cfg.AuraVal = math.clamp(1 - (ny * 0.82), 0.18, 1)
		applyLiveAuraColorOnly()
		refreshAuraUI()
		scheduleAuraSave(0.18)
	end

	wheelRingSurface.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			wheelDragTarget = "ring"
			updateAuraHueFromPos(inp.Position.X, inp.Position.Y)
		end
	end)
	wheelShadeSurface.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			wheelDragTarget = "shade"
			updateAuraShadeFromPos(inp.Position.X, inp.Position.Y)
		end
	end)
	UserInputService.InputChanged:Connect(function(inp)
		if not wheelDragTarget then return end
		if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
			if wheelDragTarget == "ring" then
				updateAuraHueFromPos(inp.Position.X, inp.Position.Y)
			elseif wheelDragTarget == "shade" then
				updateAuraShadeFromPos(inp.Position.X, inp.Position.Y)
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			if wheelDragTarget then
				wheelDragTarget = nil
				saveAuraConfigNow()
			end
		end
	end)

