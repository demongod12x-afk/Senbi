				pe.SpreadAngle = Vector2.new(360, 360)
				pe.Drag = modeName == "SMOKE" and 1.1 or 1.0
				pe.Acceleration = Vector3.new(0, 14, 0)
				pe.Rotation = NumberRange.new(-180, 180)
				pe.RotSpeed = NumberRange.new(-360, 360)
				pe.LightEmission = (modeName == "STAR_RADIANCE") and 0.95 or 0
				pe.LightInfluence = (modeName == "STAR_RADIANCE") and 0 or 0.35
