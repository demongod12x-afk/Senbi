local function makeDraggable(frame, handle, lockedFn)
	local dragHandle = handle or frame
	local dragging = false
	local moved = false
	local startPos = nil
	local frameStart = nil

	dragHandle.InputBegan:Connect(function(inp)
		if lockedFn and lockedFn() then return end
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			moved = false
			startPos = inp.Position
			frameStart = frame.Position
		end
	end)

	dragHandle.InputChanged:Connect(function(inp)
		if not dragging or (lockedFn and lockedFn()) then return end
		if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
			local delta = inp.Position - startPos
			if delta.Magnitude > 6 then moved = true end
			frame.Position = UDim2.new(
				frameStart.X.Scale, frameStart.X.Offset + delta.X,
				frameStart.Y.Scale, frameStart.Y.Offset + delta.Y
			)
		end
	end)

	dragHandle.InputEnded:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	return function()
		local m = moved
		moved = false
		return m
	end
end

local function rejoinServer()
	pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, lp) end)
	task.delay(1.5, function()
		pcall(function() TeleportService:Teleport(game.PlaceId, lp) end)
	end)
end

local function hopServer()
	task.spawn(function()
		local cursor = ""
		local servers = {}
		for _ = 1, 5 do
			local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Asc&limit=100"
			if cursor ~= "" then url = url .. "&cursor=" .. HttpService:UrlEncode(cursor) end
			local ok, raw = pcall(function() return game:HttpGet(url) end)
			if not ok or not raw then break end
			local decOk, data = pcall(function() return HttpService:JSONDecode(raw) end)
			if not decOk or type(data) ~= "table" or type(data.data) ~= "table" then break end
			for _, srv in ipairs(data.data) do
				if type(srv) == "table" and srv.id and srv.id ~= game.JobId then
					local playing = tonumber(srv.playing) or 0
					local maxPlayers = tonumber(srv.maxPlayers) or 0
					if maxPlayers > 0 and playing < maxPlayers then
						table.insert(servers, srv.id)
					end
				end
			end
			if #servers > 0 or not data.nextPageCursor or data.nextPageCursor == "" then break end
			cursor = data.nextPageCursor
		end
		if #servers > 0 then
			local chosen = servers[math.random(1, #servers)]
			pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, chosen, lp) end)
		else
			pcall(function() TeleportService:Teleport(game.PlaceId, lp) end)
		end
	end)
end

