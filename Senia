local function forceUnseatSeatParts(char)
	if not char then return end
	for _, desc in ipairs(char:GetDescendants()) do
		if desc:IsA("Weld") or desc:IsA("WeldConstraint") or desc:IsA("ManualWeld") then
			local p0, p1 = desc.Part0, desc.Part1
			if (p0 and (p0:IsA("Seat") or p0:IsA("VehicleSeat"))) or (p1 and (p1:IsA("Seat") or p1:IsA("VehicleSeat"))) then
				pcall(function() desc:Destroy() end)
			end
		end
	end
end

local function setAntiSit(hum, enabled)
	if not hum then return end
	if Cfg.HeadSit then
		pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true) end)
		return
	end
	pcall(function()
		hum:SetStateEnabled(Enum.HumanoidStateType.Seated, not enabled)
		if enabled and (hum.Sit or hum.SeatPart) then
			hum.Sit = false
			hum.SeatPart = nil
			forceUnseatSeatParts(hum.Parent)
			if hum:GetState() == Enum.HumanoidStateType.Seated then
				hum:ChangeState(Enum.HumanoidStateType.Running)
			end
		end
	end)
end

local function setNoclip(char, hum, enabled)
	if hum then
		pcall(function()
			hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, not enabled)
			hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
			if enabled and hum:GetState() == Enum.HumanoidStateType.Climbing then
				hum:ChangeState(Enum.HumanoidStateType.Running)
			end
		end)
	end
	if not char then
		noclipAnchorY = nil
		return
	end
	if enabled then
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") then
				if ncStore[p] == nil then ncStore[p] = p.CanCollide end
				pcall(function() p.CanCollide = false end)
			end
		end
	else
		noclipAnchorY = nil
		for p, oldCol in pairs(ncStore) do
			if p and p.Parent then pcall(function() p.CanCollide = oldCol end) end
			ncStore[p] = nil
		end
	end
end

local function applyNoclipHorizontalLock(char, hum, hrp)
	if not Cfg.Noclip or Cfg.Fly or Cfg.AirWalk or not char or not hum or not hrp then
		noclipAnchorY = nil
		return
	end
	local now = os.clock()
	local state = hum:GetState()
	local isJumping = hum.Jump or state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall
	if isJumping then
		noclipJumpEndTick = now + 0.55
		noclipAnchorY = nil
		return
	end
	if now < noclipJumpEndTick then return end
	local moving = hum.MoveDirection.Magnitude > 0.05
	local vel = hrp.AssemblyLinearVelocity
	if moving then
		if noclipAnchorY == nil then
			noclipAnchorY = hrp.Position.Y
		else
			local deltaY = hrp.Position.Y - noclipAnchorY
			if math.abs(deltaY) > 0.08 then
				local rotOnly = hrp.CFrame - hrp.Position
				hrp.CFrame = CFrame.new(hrp.Position.X, noclipAnchorY, hrp.Position.Z) * rotOnly
			end
		end
		if math.abs(vel.Y) > 0.1 then
			hrp.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
		end
	else
		noclipAnchorY = hrp.Position.Y
		if math.abs(vel.Y) > 0.1 then
			hrp.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
		end
	end
end

local function releaseHeadSit(hum)
	headSitActiveLastFrame = false
	if hum then
		pcall(function()
			hum.Sit = false
			hum:SetStateEnabled(Enum.HumanoidStateType.Seated, not Cfg.AntiSit)
			if hum:GetState() == Enum.HumanoidStateType.Seated then
				hum:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end)
	end
end

local function applyHeadSitLock(char, hum, hrp, tgtChar, tgtRoot, tgtHead)
	if not hum or not hrp or not tgtChar or not tgtRoot then return false end
	local hRatio = getAvatarHeightRatio(tgtChar, tgtHead)
	local myRatio = getAvatarHeightRatio(char, char:FindFirstChild("Head"))
	local lookDir = tgtRoot.CFrame.LookVector
	local flatLook = Vector3.new(lookDir.X, 0, lookDir.Z)
	flatLook = (flatLook.Magnitude < 1e-4) and Vector3.new(0, 0, -1) or flatLook.Unit
	pcall(function()
		hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
		hum.Sit = true
		if hum:GetState() ~= Enum.HumanoidStateType.Seated then
			hum:ChangeState(Enum.HumanoidStateType.Seated)
		end
	end)
	local headPos = tgtHead and tgtHead.Position or (tgtRoot.Position + Vector3.new(0, 1.5 * hRatio, 0))
	local headTopY = headPos.Y + ((tgtHead and tgtHead.Size.Y or (1.2 * hRatio)) * 0.5)
	local sitPos = Vector3.new(headPos.X, headTopY + (1.05 * myRatio), headPos.Z)
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	hrp.CFrame = CFrame.lookAt(sitPos, sitPos + flatLook)
	return true
end

local function clearMimic()
	for id, tr in pairs(mimicTracks) do
		pcall(function()
			if tr then tr:Stop(0); tr:Destroy() end
		end)
		mimicTracks[id] = nil
	end
end

local function getAllActiveAnimTracks(hum)
	local list = {}
	if not hum then return list end
	pcall(function()
		local animator = hum:FindFirstChildOfClass("Animator")
		if animator then
			for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do table.insert(list, tr) end
		end
		for _, tr in ipairs(hum:GetPlayingAnimationTracks()) do
			local dup = false
			for _, existing in ipairs(list) do
				if existing == tr then dup = true; break end
			end
			if not dup then table.insert(list, tr) end
		end
	end)
	return list
end

local function runMimic(myChar, myHum, targetPlr)
	if targetPlr ~= lastMimicTarget then
		clearMimic()
		lastMimicTarget = targetPlr
	end
	if not myChar or not myHum or not targetPlr or not targetPlr.Character then
		clearMimic()
		return
	end
	local tHum = targetPlr.Character:FindFirstChildOfClass("Humanoid")
	if not tHum then
		clearMimic()
		return
	end
	local myAnimator = myHum:FindFirstChildOfClass("Animator") or Instance.new("Animator", myHum)
	local activeKeys = {}

	for idx, src in ipairs(getAllActiveAnimTracks(tHum)) do
		local anim = src.Animation
		local animId = anim and anim.AnimationId
		if src.IsPlaying and animId and animId ~= "" then
			local key = tostring(animId) .. "#" .. tostring(idx)
			activeKeys[key] = true
			local tr = mimicTracks[key]
			if not tr then
				local newAnim = Instance.new("Animation")
				newAnim.AnimationId = animId
				local ok, loaded = pcall(function() return myAnimator:LoadAnimation(newAnim) end)
				if ok and loaded then
					pcall(function() loaded.Priority = src.Priority end)
					loaded.Looped = src.Looped
					loaded:Play(0.02, 1, normalizeEmoteSpeed(src.Speed))
					mimicTracks[key] = loaded
					tr = loaded
				end
			end
			if tr then
				pcall(function()
					if not tr.IsPlaying then tr:Play(0.02) end
					tr.Looped = src.Looped
					tr:AdjustSpeed(normalizeEmoteSpeed(src.Speed))
					if src.Length and src.Length > 0 and src.TimePosition >= 0 then
						if math.abs(tr.TimePosition - src.TimePosition) > 0.08 then
							tr.TimePosition = math.clamp(src.TimePosition, 0, math.max(0, src.Length - 0.01))
						end
					end
				end)
			end
		end
	end

	for key, tr in pairs(mimicTracks) do
		if not activeKeys[key] then
			pcall(function() tr:Stop(0.02); tr:Destroy() end)
			mimicTracks[key] = nil
		end
	end
end

local function enforceAirWalkStates(hum)
	if not hum then return end
	pcall(function()
		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
		local st = (hum.MoveDirection.Magnitude > 0.05) and Enum.HumanoidStateType.Running or Enum.HumanoidStateType.Landed
		if hum:GetState() ~= st then hum:ChangeState(st) end
	end)
end

local function sanitizeAirWalkAnim(hum)
	if not hum then return end
	pcall(function()
		local animateScript = hum.Parent and hum.Parent:FindFirstChild("Animate")
		local idleAnim = animateScript and animateScript:FindFirstChild("idle") and animateScript.idle:FindFirstChildOfClass("Animation")
		local idleId = idleAnim and idleAnim.AnimationId
		local animator = hum:FindFirstChildOfClass("Animator")
		if idleId and idleId ~= "" and animator then
			local hasIdle = false
			for _, tr in ipairs(hum:GetPlayingAnimationTracks()) do
				if tr.Animation and tr.Animation.AnimationId == idleId then
					hasIdle = true
					if not tr.IsPlaying then tr:Play(0.05) end
					break
				end
			end
			if not hasIdle and hum.MoveDirection.Magnitude <= 0.05 then
				local animInst = Instance.new("Animation")
				animInst.AnimationId = idleId
				local loaded = animator:LoadAnimation(animInst)
				loaded.Looped = true
				loaded:Play(0.05)
			end
		end
		for _, tr in ipairs(hum:GetPlayingAnimationTracks()) do
			local animName = string.lower((tr.Animation and tr.Animation.Name) or "")
			if string.find(animName, "fall", 1, true) or string.find(animName, "jump", 1, true) or string.find(animName, "climb", 1, true) then
				tr:Stop(0.05)
			end
		end
	end)
end

local function setAirWalkState(on)
	Cfg.AirWalk = (on == true)
	airMoveDir = 0
	airWalkWasMoving = false
	if airGui then airGui.Enabled = Cfg.AirWalk end
	local _, hum, hrp = getRig()
	if Cfg.AirWalk and hrp then
		airY = hrp.Position.Y
		if hum then
			if Cfg.Speed then hum.WalkSpeed = normalizeMovementSpeed(Cfg.SpeedVal) end
			enforceAirWalkStates(hum)
			sanitizeAirWalkAnim(hum)
		end
	else
		airY = nil
		if hum then
			pcall(function()
				hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
				hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
				hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
				hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, not Cfg.Noclip)
				hum.WalkSpeed = Cfg.Speed and normalizeMovementSpeed(Cfg.SpeedVal) or 16
				hum:ChangeState(Enum.HumanoidStateType.GettingUp)
			end)
		end
	end
end

