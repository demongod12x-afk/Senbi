-- Safe number parser for 100 to 10,000+ digit inputs without NaN/Inf/overflow issues
local function parseSafeNumber(raw, defaultVal, minVal, maxVal)
	if type(raw) == "number" then
		if raw ~= raw or raw == math.huge or raw == -math.huge then
			return defaultVal
		end
		return math.clamp(raw, minVal or -1e9, maxVal or 1e9)
	end
	local str = tostring(raw or ""):gsub("%s+", "")
	if str == "" or str == "-" or str == "." then
		return defaultVal
	end
	local num = tonumber(str)
	if num and num == num and num ~= math.huge and num ~= -math.huge then
		return math.clamp(num, minVal or -1e9, maxVal or 1e9)
	end
	-- Fallback for massive digit strings (100+ or 10,000+ digits)
	local sign = 1
	if str:sub(1, 1) == "-" then
		sign = -1
		str = str:sub(2)
	elseif str:sub(1, 1) == "+" then
		str = str:sub(2)
	end
	local digitsOnly = str:match("^%d+")
	if not digitsOnly or #digitsOnly == 0 then
		return defaultVal
	end
	local prefix = digitsOnly:sub(1, math.min(#digitsOnly, 12))
	local approx = (tonumber(prefix) or defaultVal) * sign
	if approx ~= approx then return defaultVal end
	return math.clamp(approx, minVal or -1e9, maxVal or 1e9)
end

local function getRig()
	local char = LocalPlayer.Character
	if not char or not char.Parent then return nil, nil, nil, nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
