local function getAuraColorSignature()
	return string.format("%s:%.3f:%.3f:%.3f", tostring(Cfg.AuraCustomColor), Cfg.AuraHue, Cfg.AuraSat, Cfg.AuraVal)
end

local function scaleAuraColor3(col, factor)
	return Color3.new(
		math.clamp(col.R * factor, 0, 1),
		math.clamp(col.G * factor, 0, 1),
		math.clamp(col.B * factor, 0, 1)
	)
end

local function getPickedAuraColor()
	if not Cfg.AuraCustomColor then
		return DEFAULT_AURA_PURPLE.Start
	end
	return Color3.fromHSV(
		math.clamp(Cfg.AuraHue, 0, 1),
		math.clamp(Cfg.AuraSat, 0, 1),
		math.clamp(Cfg.AuraVal, 0.18, 1)
	)
end

local function buildAuraColorSet(modeName)
	if not Cfg.AuraCustomColor then
		if modeName == "SURGE" then
			return {
				Start = DEFAULT_SURGE_PURPLE.Start,
				Mid = DEFAULT_SURGE_PURPLE.Mid,
				Deep = DEFAULT_SURGE_PURPLE.Deep,
				End = DEFAULT_SURGE_PURPLE.End,
				Outline = DEFAULT_SURGE_PURPLE.Outline,
				Light = DEFAULT_SURGE_PURPLE.Light,
			}
		end
		return DEFAULT_AURA_PURPLE
	end
	local baseCol = getPickedAuraColor()
	local surgeBoost = (modeName == "SURGE") and 1.12 or 1.0
	return {
		Start = scaleAuraColor3(baseCol, math.clamp(1.0 * surgeBoost, 0.15, 1.25)),
		Mid = scaleAuraColor3(baseCol, math.clamp(0.75 * surgeBoost, 0.12, 1.1)),
		Deep = scaleAuraColor3(baseCol, math.clamp(0.52 * surgeBoost, 0.08, 0.9)),
		End = scaleAuraColor3(baseCol, math.clamp(0.32 * surgeBoost, 0.05, 0.7)),
		Outline = scaleAuraColor3(baseCol, math.clamp(1.22 * surgeBoost, 0.25, 1.45)),
		Light = scaleAuraColor3(baseCol, math.clamp(0.95 * surgeBoost, 0.15, 1.2)),
	}
end

local function makeAuraSequence(modeName)
	local set = buildAuraColorSet(modeName)
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, set.Start),
		ColorSequenceKeypoint.new(0.45, set.Mid),
		ColorSequenceKeypoint.new(0.82, set.Deep),
		ColorSequenceKeypoint.new(1, set.End),
	})
end

local function markAuraOwned(inst, tagName)
	inst:SetAttribute(AURA_OWNER_ATTR, true)
	inst:SetAttribute("MortalAuraFX", true)
	if tagName then
		inst:SetAttribute(tagName, true)
	end
end

local function clearAuraEffects()
	for _, item in ipairs(activeAuraItems) do
		if item.emitters then
			for _, pe in ipairs(item.emitters) do
				local emitter = pe.emitter or pe
				pcall(function() emitter.Enabled = false; emitter:Clear(); emitter:Destroy() end)
			end
		end
		if item.spreadEmitters then
			for _, spe in ipairs(item.spreadEmitters) do
				pcall(function() spe.Enabled = false; spe:Clear(); spe:Destroy() end)
			end
		end
		if item.light then
			pcall(function() item.light.Enabled = false; item.light:Destroy() end)
		end
		if item.extras then
			for _, ex in ipairs(item.extras) do
				pcall(function() ex:Destroy() end)
			end
		end
	end
	table.clear(activeAuraItems)
	for _, pe in ipairs(activeAuraEmitters) do
		local emitter = pe.emitter or pe
		pcall(function() emitter.Enabled = false; emitter:Clear(); emitter:Destroy() end)
	end
	table.clear(activeAuraEmitters)
	for _, att in ipairs(activeAuraAttachments) do
		pcall(function() att:Destroy() end)
	end
	table.clear(activeAuraAttachments)
	for _, ex in ipairs(activeAuraExtras) do
		pcall(function() ex:Destroy() end)
	end
	table.clear(activeAuraExtras)

	local roots = {}
	if LocalPlayer.Character then table.insert(roots, LocalPlayer.Character) end
	table.insert(roots, workspace)
	for _, root in ipairs(roots) do
		local ok, descList = pcall(function() return root:GetDescendants() end)
		if ok and descList then
			for _, desc in ipairs(descList) do
				if desc:GetAttribute(AURA_OWNER_ATTR) or desc:GetAttribute("MortalAuraFX") then
					pcall(function() desc:Destroy() end)
				end
			end
		end
	end
	builtAuraMode = nil
	builtAuraLevel = nil
	builtAuraUltimate = nil
	builtAuraChar = nil
	builtAuraColorSig = nil
	lastSurgeBurstTick = -1
end

local function applyLiveAuraColorOnly()
	local modeName = AURA_MODES[Cfg.AuraModeIdx] or "COLUMN"
	local seq = makeAuraSequence(modeName)
	local set = buildAuraColorSet(modeName)
	for _, pe in ipairs(activeAuraEmitters) do
		local emitter = pe.emitter or pe
		if emitter and emitter.Parent then
			emitter.Color = seq
		end
	end
	for _, item in ipairs(activeAuraItems) do
		if item.emitters then
			for _, pe in ipairs(item.emitters) do
				local emitter = pe.emitter or pe
				if emitter and emitter.Parent then
					emitter.Color = seq
				end
			end
		end
		if item.spreadEmitters then
			for _, spe in ipairs(item.spreadEmitters) do
				if spe and spe.Parent then
					spe.Color = seq
				end
			end
		end
		if item.light and item.light.Parent then
			item.light.Color = set.Light
		end
		if item.extras then
			for _, ex in ipairs(item.extras) do
				if ex and ex.Parent then
					if ex:IsA("Highlight") then
						ex.FillColor = set.Deep
						ex.OutlineColor = set.Outline
					elseif ex:IsA("PointLight") then
						ex.Color = set.Light
					end
				end
			end
		end
	end
	for _, ex in ipairs(activeAuraExtras) do
		if ex and ex.Parent then
			if ex:IsA("Highlight") then
				ex.FillColor = set.Deep
				ex.OutlineColor = set.Outline
			elseif ex:IsA("PointLight") then
				ex.Color = set.Light
			end
		end
	end
	builtAuraColorSig = getAuraColorSignature()
end

local function getAuraTargetParts(char)
	local parts = {}
	for _, desc in ipairs(char:GetDescendants()) do
		if desc:IsA("BasePart") and desc.Name ~= "HumanoidRootPart" then
			table.insert(parts, desc)
		end
	end
	return parts
end

local function collectAuraBodyParts(char, hrp)
	local parts = {}
	for _, desc in ipairs(char:GetDescendants()) do
		if desc:IsA("BasePart") and desc.Name ~= "HumanoidRootPart" and desc.Size.Magnitude > 0.15 then
			table.insert(parts, desc)
		end
	end
	if #parts == 0 then
		table.insert(parts, hrp)
	end
	return parts
end

local function isAuraLegOrFoot(part)
	local n = string.lower(part.Name)
	return string.find(n, "leg", 1, true) ~= nil
		or string.find(n, "foot", 1, true) ~= nil
		or string.find(n, "feet", 1, true) ~= nil
		or string.find(n, "ankle", 1, true) ~= nil
		or string.find(n, "shin", 1, true) ~= nil
		or string.find(n, "thigh", 1, true) ~= nil
end

