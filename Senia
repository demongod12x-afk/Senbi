local function makeDraggable(frame, handle, holdMode, lockedFn)
	local dragHandle = handle or frame
	local pressed = false
	local activeDrag = false
	local moved = false
	local startPos = nil
	local frameStart = nil
	local token = 0
	local function resetDrag()
		pressed = false
		activeDrag = false
		token = token + 1
	end
	dragHandle.InputBegan:Connect(function(inp)
		if lockedFn and lockedFn() then
			resetDrag()
			return
		end
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			pressed = true
			activeDrag = not holdMode
			moved = false
			startPos = inp.Position
			frameStart = frame.Position
			token = token + 1
			local myToken = token
			if holdMode then
				task.delay(0.22, function()
					if lockedFn and lockedFn() then
						resetDrag()
						return
					end
					if pressed and token == myToken then
						activeDrag = true
					end
				end)
			end
		end
	end)
	UserInputService.InputChanged:Connect(function(inp)
		if lockedFn and lockedFn() then
			resetDrag()
			return
		end
		if not pressed then return end
		if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then
			local delta = inp.Position - startPos
			if not activeDrag and holdMode and delta.Magnitude > 14 then
				activeDrag = true
			end
			if activeDrag then
				if delta.Magnitude > 6 then
					moved = true
				end
				frame.Position = UDim2.new(
					frameStart.X.Scale,
					frameStart.X.Offset + delta.X,
					frameStart.Y.Scale,
					frameStart.Y.Offset + delta.Y
				)
			end
		end
	end)
	dragHandle.InputEnded:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			resetDrag()
		end
	end)
	UserInputService.InputEnded:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			resetDrag()
		end
	end)
	return function()
		local wasMove = moved
		moved = false
		return wasMove
	end
end

local function createEyeGraphic(parentFrame, eyeW, eyeH, irisSize, pupilSize, zBase)
	local eWhite = Instance.new("Frame")
	eWhite.Size = UDim2.new(0, eyeW, 0, eyeH)
	eWhite.Position = UDim2.new(0.5, -eyeW * 0.5, 0.5, -eyeH * 0.5)
	eWhite.BackgroundColor3 = Color3.fromRGB(240, 228, 255)
	eWhite.BorderSizePixel = 0
	eWhite.ZIndex = zBase
	eWhite.Parent = parentFrame
	Instance.new("UICorner", eWhite).CornerRadius = UDim.new(1, 0)
	addBorder(eWhite, NEON_RIFT, 1.3, 0.08)

	local eIris = Instance.new("Frame")
	eIris.Size = UDim2.new(0, irisSize, 0, irisSize)
	eIris.Position = UDim2.new(0.5, -irisSize * 0.5, 0.5, -irisSize * 0.5)
	eIris.BackgroundColor3 = BTN_ON
	eIris.BorderSizePixel = 0
	eIris.ZIndex = zBase + 1
	eIris.Parent = eWhite
	Instance.new("UICorner", eIris).CornerRadius = UDim.new(1, 0)

	local ePupil = Instance.new("Frame")
