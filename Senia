local function registerPlayer(plr)
	if plr ~= LocalPlayer then
		if showFriendJoinNotify then pcall(showFriendJoinNotify, plr) end
		plr.CharacterAdded:Connect(function()
			task.defer(function()
				updateThirdEyeTag(plr)
				syncAllESP()
			end)
		end)
	end
	updateThirdEyeTag(plr)
	syncAllESP()
end

Players.PlayerAdded:Connect(function(plr)
	registerPlayer(plr)
	if pages[2] and pages[2].Visible and rebuildFriendsList then pcall(rebuildFriendsList) end
end)

Players.PlayerRemoving:Connect(function(plr)
	friendEspSet[plr] = nil
	targetEspSet[plr] = nil
	clearESP(plr)
	clearThirdEyeTag(plr)
	if spectatedFriend == plr then spectatedFriend = nil end
end)

if LocalPlayer then
	LocalPlayer.CharacterAdded:Connect(function(char)
		stopFly()
		airMoveDir = 0
		airWalkWasMoving = false
		if Cfg.AirWalk then airY = nil end
		markSelfScriptPresence(char)
		task.defer(function()
			updateThirdEyeTag(LocalPlayer)
			syncAllESP()
		end)
	end)
	if LocalPlayer.Character then markSelfScriptPresence(LocalPlayer.Character) end
end

for _, plr in ipairs(Players:GetPlayers()) do registerPlayer(plr) end

do
	local lastStatsRefresh = 0
	local lastVisualSyncRefresh = 0
	local fpsAccumTime = 0
	local fpsAccumFrames = 0

	RunService.RenderStepped:Connect(function(dt)
		pcall(function()
			local now = os.clock()
			local safeDt = math.clamp(dt, 0.001, 0.05)

			fpsAccumTime = fpsAccumTime + dt
			fpsAccumFrames = fpsAccumFrames + 1
			if eye1FpsLbl and fpsAccumTime >= 0.35 then
				local avgFps = math.clamp(math.floor((fpsAccumFrames / fpsAccumTime) + 0.5), 1, 240)
				eye1FpsLbl.Text = tostring(avgFps) .. " FPS"
				fpsAccumTime = 0
				fpsAccumFrames = 0
			end

			if eye1Pupil then
				eye1Pupil.Position = UDim2.new(0.5 + math.cos(now * 2.0) * 0.14, -2.5, 0.5 + math.sin(now * 1.5) * 0.12, -2.5)
			end
			if topEyePupil then
				topEyePupil.Position = UDim2.new(0.5 + math.cos(now * 2.2) * 0.12, -2, 0.5 + math.sin(now * 1.8) * 0.1, -2)
			end

			if now - lastStatsRefresh >= 0.6 then
				lastStatsRefresh = now
				if topStatsLbl then
					topStatsLbl.Text = "PLAYERS: " .. tostring(#Players:GetPlayers()) .. " | PING: " .. tostring(getPing()) .. "ms"
				end
			end

			if now - lastVisualSyncRefresh >= 0.2 then
				lastVisualSyncRefresh = now
				for _, plr in ipairs(Players:GetPlayers()) do updateThirdEyeTag(plr) end
				syncAllESP()
			end

			local char, hum, hrp = getRig()
			if not char or not hum or not hrp then return end

			local targetSpeed = Cfg.Speed and normalizeMovementSpeed(Cfg.SpeedVal) or 16
			if Cfg.Speed then hum.WalkSpeed = targetSpeed end
			if Cfg.Jump then
				hum.UseJumpPower = true
				hum.JumpPower = normalizeJumpPower(Cfg.JumpVal)
			end

			if Cfg.EmoteSpeed then
				local safeSpd = normalizeEmoteSpeed(Cfg.EmoteVal)
				for _, tr in ipairs(getAllActiveAnimTracks(hum)) do
					pcall(function()
						if math.abs(tr.Speed - safeSpd) > 0.01 then
							tr:AdjustSpeed(safeSpd)
						end
					end)
				end
			end

			if Cfg.AirWalk then
				sanitizeAirWalkAnim(hum)
				enforceAirWalkStates(hum)
				if airY == nil then airY = hrp.Position.Y end
				if airMoveDir ~= 0 then
					airY = airY + (airMoveDir * Cfg.AirStep * math.clamp(dt * 60, 0.25, 2.5))
				end
				local movingNow = hum.MoveDirection.Magnitude > 0.05
				if movingNow then
					airWalkWasMoving = true
					hum.WalkSpeed = targetSpeed
				else
					if airWalkWasMoving then
						airWalkWasMoving = false
						hum.WalkSpeed = 0
						task.defer(function()
							if Cfg.AirWalk and hum and hum.Parent then
								hum.WalkSpeed = Cfg.Speed and targetSpeed or 16
							end
						end)
					end
					hrp.AssemblyLinearVelocity = Vector3.zero
				end
				local pos = hrp.Position
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.CFrame = CFrame.new(pos.X, airY, pos.Z) * (hrp.CFrame - hrp.Position)
			else
				airWalkWasMoving = false
			end

			if Cfg.Spin then
				local angDelta = math.rad(normalizeSpinSpeed(Cfg.SpinVal) * 6 * safeDt)
				local pos = hrp.Position
				local rotOnly = (hrp.CFrame - pos) * CFrame.Angles(0, angDelta, 0)
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.CFrame = CFrame.new(pos) * rotOnly
			end
		end)
	end)
end
