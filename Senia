		AuraSat = math.clamp(tonumber(Cfg.AuraSat) or 0.94, 0, 1),
		AuraVal = math.clamp(tonumber(Cfg.AuraVal) or 0.65, 0.18, 1),
		AuraCustomColor = Cfg.AuraCustomColor == true,
	}
	pcall(function()
		if type(getgenv) == "function" then
