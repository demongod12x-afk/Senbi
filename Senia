local function attachEmitter(parentPart, opts)
	local pe = Instance.new("ParticleEmitter")
	pe:SetAttribute("SeniaAuraFX", true)
	pe.Texture = opts.texture or STAR_TEXTURE
	pe.Color = opts.color
	pe.Size = opts.size
	pe.Transparency = opts.transparency or NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.05),
		NumberSequenceKeypoint.new(0.60, 0.25),
		NumberSequenceKeypoint.new(1, 1),
	})
	pe.Lifetime = opts.lifetime or NumberRange.new(0.45, 0.85)
	pe.Rate = math.max(50, math.floor(opts.rate or 200))
	pe.Speed = opts.speed
	pe.SpreadAngle = opts.spread
	pe.RotSpeed = opts.rotSpeed or NumberRange.new(-120, 120)
	pe.Rotation = NumberRange.new(-180, 180)
	pe.Drag = opts.drag or 1.15
	pe.LightEmission = opts.lightEmission or 0.9
	pe.Acceleration = opts.accel or Vector3.new(0, 4, 0)
	pe.Parent = parentPart
	return pe
end

local function buildAura(char, hrp)
	if not char or not hrp then return end
	AuraSystem.Clear()

	local auraId = State.SelectedAura
	local lvl = State.AuraLevel
	local spreadFlag = State.UltimateSpread and "1" or "0"
	builtKey = tostring(char) .. "_" .. tostring(auraId) .. "_" .. tostring(lvl) .. "_" .. spreadFlag

	local folder = Instance.new("Folder")
	folder.Name = "SeniaAuraFX"
	folder.Parent = char
	auraFolder = folder

	local tier = getTier()
	local spreadMult = State.UltimateSpread and 2.2 or 1.0
	local ok, ext = pcall(function() return char:GetExtentsSize() end)
	local avatarScale = (ok and typeof(ext) == "Vector3" and ext.Y > 1) and math.clamp(ext.Y / 5.0, 0.55, 2.2) or 1.0
	local fixedScale = math.clamp(avatarScale, 0.85, 1.40)

	local bodyParts = {}
	for _, child in ipairs(char:GetDescendants()) do
		if child:IsA("BasePart") and child.Name ~= "HumanoidRootPart" and child.Size.Magnitude > 0.15 then
			table.insert(bodyParts, child)
		end
	end
	if #bodyParts == 0 then table.insert(bodyParts, hrp) end

	if auraId == "mortals_neverdie" then
		local cFolder = Instance.new("Folder")
		cFolder.Name = "SeniaGroundCracks"
		cFolder.Parent = workspace
		crackRootFolder = cFolder

		local ptLight = Instance.new("PointLight")
		ptLight:SetAttribute("SeniaAuraFX", true)
		ptLight.Color = Color3.fromRGB(155, 35, 255)
		ptLight.Range = tier.lightRange * (State.UltimateSpread and 1.6 or 1.0)
		ptLight.Brightness = tier.lightBright
		ptLight.Parent = hrp

		table.insert(activeAuraItems, {
			kind = "mortals_neverdie",
			crackFolder = cFolder,
			walkCracks = {},
			landingCracks = {},
			fixedScale = fixedScale,
			spreadMult = spreadMult,
			light = ptLight,
		})
	elseif auraId == "surge" then
		local emitters = {}
		local sMult = tier.sizeMult * fixedScale * (State.UltimateSpread and 1.45 or 1.0)
		local rate = (140 * tier.rateMult * spreadMult) / math.max(1, #bodyParts)
		for _, bp in ipairs(bodyParts) do
			table.insert(emitters, attachEmitter(bp, {
				texture = STAR_TEXTURE,
				color = ColorSequence.new(State.AuraColor, Color3.fromRGB(255, 230, 120)),
				size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.5 * sMult),
					NumberSequenceKeypoint.new(0.5, 1.8 * sMult),
					NumberSequenceKeypoint.new(1, 0),
				}),
				rate = rate,
				speed = NumberRange.new(8 * tier.speedMult * spreadMult, 20 * tier.speedMult * spreadMult),
				spread = Vector2.new(math.clamp(120 * tier.spreadMult * spreadMult, 40, 180), math.clamp(120 * tier.spreadMult * spreadMult, 40, 180)),
				accel = Vector3.new(0, 12 * tier.speedMult, 0),
			}))
		end

		local ptLight = Instance.new("PointLight")
		ptLight:SetAttribute("SeniaAuraFX", true)
		ptLight.Color = State.AuraColor
		ptLight.Range = tier.lightRange * spreadMult
		ptLight.Brightness = tier.lightBright * (1 + lvl * 0.25)
		ptLight.Parent = hrp

		table.insert(activeAuraItems, {
			kind = "surge",
			emitters = emitters,
			light = ptLight,
			fixedScale = fixedScale,
			spreadMult = spreadMult,
		})
	elseif auraId == "smoke" then
		local emitters = {}
		local sMult = tier.sizeMult * fixedScale * (State.UltimateSpread and 1.65 or 1.0)
		local rate = (110 * tier.rateMult * spreadMult) / math.max(1, #bodyParts)
		for _, bp in ipairs(bodyParts) do
