local function getActiveTargetPlayer()
	local direct = findPlayer(Cfg.Target)
	if direct then return direct end
	for plr, active in pairs(targetEspSet) do
		if active and plr and plr.Parent == Players then return plr end
	end
	return nil
end

local function syncAllESP()
	local targetPlr = getActiveTargetPlayer()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local isTgt = (targetPlr == plr) or (targetEspSet[plr] == true)
			local isFrd = (friendEspSet[plr] == true)
			local isAll = (Cfg.ESPAll == true)
			if isTgt then
				drawESP(plr, TARGET_BODY_RED, TARGET_NAME_YELLOW, "TARGET")
			elseif isFrd then
				drawESP(plr, FRIEND_BODY_BLUE, FRIEND_NAME_BROWN, "FRIEND")
			elseif isAll then
				drawESP(plr, ALL_BODY_PURPLE, ALL_NAME_GREEN, "ALL")
			else
				clearESP(plr)
			end
		end
	end
end

