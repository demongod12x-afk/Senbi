local function parseHugeNum(raw, defaultVal, minVal)
	local str = tostring(raw or ""):gsub("[%s_,]", "")
	if str == "" then return defaultVal end
	local n = tonumber(str)
	if n == nil or n ~= n then
		local cleanDigits = str:match("^([+-]?%d+)")
		if cleanDigits then
			local sign = (cleanDigits:sub(1, 1) == "-") and -1 or 1
			local digitsOnly = cleanDigits:gsub("^[+-]", "")
			if #digitsOnly >= 309 then
				n = sign * 1e308
			elseif #digitsOnly > 0 then
				local head = digitsOnly:sub(1, math.min(15, #digitsOnly))
				local expPart = #digitsOnly - #head
				n = sign * (tonumber(head) or 1) * (10 ^ expPart)
			end
		end
	end
	if n == nil or n ~= n then return defaultVal end
	if n == math.huge then n = 1e308 elseif n == -math.huge then n = -1e308 end
	if minVal and n < minVal then n = minVal end
	return n
end

local function normalizeMovementSpeed(v)
	local n = tonumber(v) or 16
	if n ~= n or n < 0 then return n ~= n and 16 or 0 end
	return n
end

local function normalizeJumpPower(v)
	local n = tonumber(v) or 50
	if n ~= n or n < 0 then return n ~= n and 50 or 0 end
	return n
end

local function normalizeFlySpeed(v)
	local n = tonumber(v) or 50
	if n ~= n or n < 0 then return n ~= n and 50 or 0 end
	return n
end

local function normalizeSpinSpeed(v)
	local n = tonumber(v) or 50
	return (n == n) and n or 50
end

local function normalizeEmoteSpeed(v)
	local n = tonumber(v) or 1
	return (n == n) and n or 1
end

