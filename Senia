local auraSaveVer = 0
local function saveAuraConfigNow()
	local payload = {
		AuraEnabled = Cfg.AuraEnabled == true,
		AuraModeIdx = math.clamp(tonumber(Cfg.AuraModeIdx) or 1, 1, #AURA_MODES),
		AuraLevel = math.clamp(tonumber(Cfg.AuraLevel) or 1, 1, MAX_AURA_LEVEL),
		UltimateSpread = Cfg.UltimateSpread == true,
		AuraHue = math.clamp(tonumber(Cfg.AuraHue) or 0.77, 0, 1),
		AuraSat = math.clamp(tonumber(Cfg.AuraSat) or 0.94, 0, 1),
		AuraVal = math.clamp(tonumber(Cfg.AuraVal) or 0.65, 0.18, 1),
		AuraCustomColor = Cfg.AuraCustomColor == true,
	}
	pcall(function()
		if type(getgenv) == "function" then
			getgenv().MortalHubAuraSaved = payload
		end
	end)
	if type(writefile) == "function" then
		pcall(function()
			writefile(AURA_SAVE_FILE, HttpService:JSONEncode(payload))
		end)
	end
end

local function scheduleAuraSave(delaySec)
	auraSaveVer = auraSaveVer + 1
	local ver = auraSaveVer
	task.delay(delaySec or 0.18, function()
		if ver == auraSaveVer then
			saveAuraConfigNow()
		end
	end)
end

local function loadAuraConfig()
	local loaded = nil
	if type(isfile) == "function" and type(readfile) == "function" then
		local okEx, ex = pcall(isfile, AURA_SAVE_FILE)
		if okEx and ex then
			local okR, raw = pcall(readfile, AURA_SAVE_FILE)
			if okR and type(raw) == "string" and #raw > 0 then
				local okD, dec = pcall(function() return HttpService:JSONDecode(raw) end)
				if okD and type(dec) == "table" then
					loaded = dec
				end
			end
		end
	end
	if not loaded then
		pcall(function()
			if type(getgenv) == "function" and type(getgenv().MortalHubAuraSaved) == "table" then
				loaded = getgenv().MortalHubAuraSaved
			end
		end)
	end
	if type(loaded) == "table" then
		Cfg.AuraEnabled = (loaded.AuraEnabled == true)
		Cfg.AuraModeIdx = math.clamp(tonumber(loaded.AuraModeIdx) or 1, 1, #AURA_MODES)
		Cfg.AuraLevel = math.clamp(tonumber(loaded.AuraLevel) or 1, 1, MAX_AURA_LEVEL)
		Cfg.UltimateSpread = (loaded.UltimateSpread == true)
		Cfg.AuraHue = math.clamp(tonumber(loaded.AuraHue) or 0.77, 0, 1)
		Cfg.AuraSat = math.clamp(tonumber(loaded.AuraSat) or 0.94, 0, 1)
		Cfg.AuraVal = math.clamp(tonumber(loaded.AuraVal) or 0.65, 0.18, 1)
		Cfg.AuraCustomColor = (loaded.AuraCustomColor == true)
	end
end
