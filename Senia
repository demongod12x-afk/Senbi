-- ============================================================================
-- 3RD EYE OVERHEAD TAG (ONLY FOR GANG / SCRIPT USERS)
-- ============================================================================
local thirdEyeTagStore = {}

local function clearThirdEyeTag(plr)
	if thirdEyeTagStore[plr] then
		pcall(function()
			if thirdEyeTagStore[plr].Billboard then
				thirdEyeTagStore[plr].Billboard:Destroy()
			end
		end)
		thirdEyeTagStore[plr] = nil
	end
end

local function updateThirdEyeTag(plr)
	if not plr or not plr.Parent or not GangUsers[plr.UserId] then
		clearThirdEyeTag(plr)
		return
	end
	local pChar = plr.Character
	local head = pChar and pChar:FindFirstChild("Head")
	if not pChar or not head or not head:IsA("BasePart") then
		clearThirdEyeTag(plr)
		return
	end

	local entry = thirdEyeTagStore[plr]
	if not entry or entry.Char ~= pChar or not entry.Billboard or not entry.Billboard.Parent then
		clearThirdEyeTag(plr)
		pcall(function()
			local dispName = plr.DisplayName
			local barW = math.clamp(#dispName * 7.2 + 40, 108, 175)

			local bb = Instance.new("BillboardGui")
			bb.Name = "MortalMemberTag"
			bb.Size = UDim2.new(0, barW, 0, 24)
			bb.StudsOffset = Vector3.new(0, 2.8, 0)
			bb.AlwaysOnTop = true
			bb.MaxDistance = 9999
			bb.Parent = head

			local bar = Instance.new("Frame")
			bar.Size = UDim2.new(1, 0, 1, 0)
			bar.BackgroundColor3 = TAG_DARK_BAR
			bar.BackgroundTransparency = 0.04
			bar.BorderSizePixel = 0
			bar.Parent = bb
			Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 8)
			addBorder(bar, TAG_NEON_OUTLINE, 1.7, 0.05)

			local lay = Instance.new("UIListLayout")
			lay.FillDirection = Enum.FillDirection.Horizontal
			lay.HorizontalAlignment = Enum.HorizontalAlignment.Center
			lay.VerticalAlignment = Enum.VerticalAlignment.Center
			lay.Padding = UDim.new(0, 4)
			lay.Parent = bar

			local eyeHolder = Instance.new("Frame")
			eyeHolder.Size = UDim2.new(0, 20, 0, 14)
			eyeHolder.BackgroundTransparency = 1
			eyeHolder.Parent = bar
			local pupil = createEyeGraphic(eyeHolder, 18, 11, 7, 3, 5)

			local lbl = Instance.new("TextLabel")
			lbl.Size = UDim2.new(0, barW - 30, 1, 0)
			lbl.BackgroundTransparency = 1
			lbl.Font = Enum.Font.GothamBlack
			lbl.TextSize = 11
			lbl.TextScaled = true
			lbl.Text = dispName
			lbl.TextColor3 = TAG_NEON_PURPLE
			lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
			lbl.TextStrokeTransparency = 0
			lbl.Parent = bar

			thirdEyeTagStore[plr] = { Char = pChar, Billboard = bb, Pupil = pupil }
		end)
	elseif entry.Pupil then
		pcall(function()
			local t = os.clock()
			entry.Pupil.Position = UDim2.new(0.5 + math.cos(t * 2.2) * 0.12, -1.5, 0.5 + math.sin(t * 1.7) * 0.1, -1.5)
		end)
	end
end

local function registerGangPlayer(uid)
	local numId = tonumber(uid)
	if not numId then return end
	if not GangUsers[numId] then
		GangUsers[numId] = true
		local plr = Players:GetPlayerByUserId(numId)
		if plr then
			pcall(updateThirdEyeTag, plr)
		end
		if refreshFriendsUI then
			pcall(refreshFriendsUI)
		end
	end
end

-- Live Gang Presence Sync via ReplicatedStorage / Player Attributes
local gangFolder = ReplicatedStorage:FindFirstChild("MortalGangSync")
if not gangFolder then
	pcall(function()
		gangFolder = Instance.new("Folder")
		gangFolder.Name = "MortalGangSync"
		gangFolder.Parent = ReplicatedStorage
	end)
end

local function announceSelfInGang()
	pcall(function()
		lp:SetAttribute("MortalGangActive", true)
	end)
	if gangFolder then
		pcall(function()
			local marker = gangFolder:FindFirstChild("U_" .. userIdStr)
			if not marker then
				marker = Instance.new("BoolValue")
				marker.Name = "U_" .. userIdStr
				marker.Value = true
				marker.Parent = gangFolder
			end
		end)
	end
end

local function scanGangUsers()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr == lp or plr:GetAttribute("MortalGangActive") == true then
			registerGangPlayer(plr.UserId)
		end
	end
	if gangFolder then
		for _, ch in ipairs(gangFolder:GetChildren()) do
			local uidPart = string.match(ch.Name, "^U_(%d+)$")
			if uidPart then
				registerGangPlayer(uidPart)
			end
		end
	end
end

announceSelfInGang()
scanGangUsers()

if gangFolder then
	gangFolder.ChildAdded:Connect(function(ch)
		local uidPart = string.match(ch.Name, "^U_(%d+)$")
		if uidPart then
			registerGangPlayer(uidPart)
		end
	end)
end

local function hookPlayer(plr)
	pcall(function()
		if plr == lp or plr:GetAttribute("MortalGangActive") == true then
			registerGangPlayer(plr.UserId)
		end
		plr:GetAttributeChangedSignal("MortalGangActive"):Connect(function()
			if plr:GetAttribute("MortalGangActive") == true then
				registerGangPlayer(plr.UserId)
			end
		end)
		plr.CharacterAdded:Connect(function()
			task.spawn(function()
				local char = plr.Character or plr.CharacterAdded:Wait()
				if char then
					char:WaitForChild("Head", 5)
					task.wait(0.1)
					pcall(updateThirdEyeTag, plr)
				end
			end)
		end)
		if refreshFriendsUI then
			pcall(refreshFriendsUI)
		end
	end)
end

for _, plr in ipairs(Players:GetPlayers()) do
	hookPlayer(plr)
end

Players.PlayerAdded:Connect(hookPlayer)
Players.PlayerRemoving:Connect(function(plr)
	clearThirdEyeTag(plr)
	if refreshFriendsUI then
		pcall(refreshFriendsUI)
	end
end)

