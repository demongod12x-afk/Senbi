local function clearMimic()
	for id, tr in pairs(mimicTracks) do
		pcall(function()
			if tr then
				tr:Stop(0)
				tr:Destroy()
			end
		end)
		mimicTracks[id] = nil
	end
end

local function runMimic(myChar, myHum, targetPlr)
	if targetPlr ~= lastMimicTarget then
		clearMimic()
		lastMimicTarget = targetPlr
	end
	if not myChar or not myHum or not targetPlr or not targetPlr.Character then
		clearMimic()
		return
	end
	local tHum = targetPlr.Character:FindFirstChildOfClass("Humanoid")
	if not tHum then
		clearMimic()
		return
	end
	local myAnimator = myHum:FindFirstChildOfClass("Animator") or Instance.new("Animator", myHum)
	local active = {}
	pcall(function()
		for _, src in ipairs(tHum:GetPlayingAnimationTracks()) do
			local anim = src.Animation
			local animId = anim and anim.AnimationId
			if src.IsPlaying and animId and animId ~= "" then
				active[animId] = true
				local tr = mimicTracks[animId]
				if not tr then
					local newAnim = Instance.new("Animation")
					newAnim.AnimationId = animId
					local ok, loaded = pcall(function() return myAnimator:LoadAnimation(newAnim) end)
					if ok and loaded then
						loaded.Priority = src.Priority
						loaded.Looped = src.Looped
						loaded:Play(0.05)
						mimicTracks[animId] = loaded
						tr = loaded
					end
				end
				if tr then
					if not tr.IsPlaying then tr:Play(0.05) end
					local spd = tonumber(src.Speed) or 1
					if spd ~= spd or spd == math.huge then spd = 100 elseif spd == -math.huge then spd = -100 end
					tr:AdjustSpeed(math.clamp(spd, -100, 100))
					if math.abs(tr.TimePosition - src.TimePosition) > 0.2 then
						tr.TimePosition = src.TimePosition
					end
				end
			end
		end
	end)
	for id, tr in pairs(mimicTracks) do
		if not active[id] then
			pcall(function()
				tr:Stop(0.05)
				tr:Destroy()
			end)
			mimicTracks[id] = nil
		end
	end
end

local function enforceAirWalkStates(hum)
	if not hum then return end
	pcall(function()
		hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
		hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
		local moving = hum.MoveDirection.Magnitude > 0.05
		local st = moving and Enum.HumanoidStateType.Running or Enum.HumanoidStateType.Landed
		if hum:GetState() ~= st then
			hum:ChangeState(st)
		end
	end)
end

