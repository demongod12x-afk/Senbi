	b.Parent = parent
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 7)
	addBorder(b, NEON_RING, 1, 0.35)
	b.MouseButton1Click:Connect(function()
		playClick(1.0)
		if onClick then onClick(b) end
	end)
	return b
end

local function makeToggle(parent, label, getState, setState)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0.96, 0, 0, 28)
	local function sync()
		local on = getState() == true
		b.Text = label .. ": " .. (on and "ON" or "OFF")
		b.BackgroundColor3 = on and BTN_ON or BTN_OFF
	end
	sync()
	b.Font = Enum.Font.GothamBold
	b.TextSize = 11
	b.TextColor3 = TEXT_MAIN
	b.ZIndex = 33
	b.Parent = parent
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 7)
	addBorder(b, NEON_RING, 1, 0.35)
	b.MouseButton1Click:Connect(function()
		local nextState = not (getState() == true)
		setState(nextState)
		sync()
		playClick(nextState and 1.15 or 0.9)
	end)
	return b, sync
end

local function makeNumRow(parent, label, getState, setState, getVal, setVal, minV, bindSyncFn, liveApplyFn)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(0.96, 0, 0, 28)
	row.BackgroundTransparency = 1
	row.ZIndex = 33
	row.Parent = parent

	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0.64, -2, 1, 0)
	b.BackgroundColor3 = BTN_OFF
	b.Font = Enum.Font.GothamBold
	b.TextSize = 11
	b.TextColor3 = TEXT_MAIN
	b.ZIndex = 33
	b.Parent = row
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 7)
	addBorder(b, NEON_RING, 1, 0.35)

	local box = Instance.new("TextBox")
	box.Size = UDim2.new(0.36, -2, 1, 0)
	box.Position = UDim2.new(0.64, 2, 0, 0)
	box.BackgroundColor3 = VOID_BG
	box.Font = Enum.Font.GothamBold
	box.TextSize = 11
	box.Text = tostring(getVal())
	box.TextColor3 = TAG_NEON_PURPLE
	box.ClearTextOnFocus = true
	box.ZIndex = 33
	box.Parent = row
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 7)
	addBorder(box, NEON_RING, 1, 0.35)

	local function syncBtn()
		local on = getState() == true
		b.Text = label .. ": " .. (on and "ON" or "OFF")
		b.BackgroundColor3 = on and BTN_ON or BTN_OFF
	end
	syncBtn()
	if bindSyncFn then bindSyncFn(syncBtn) end

	b.MouseButton1Click:Connect(function()
		local parsed = parseHugeNum(box.Text, getVal(), minV)
		setVal(parsed)
		box.Text = tostring(parsed)
		local nextState = not (getState() == true)
		setState(nextState, parsed)
		syncBtn()
		playClick(nextState and 1.15 or 0.9)
	end)

	box:GetPropertyChangedSignal("Text"):Connect(function()
		if box.Text == "" then return end
		local parsed = parseHugeNum(box.Text, getVal(), minV)
		setVal(parsed)
		if liveApplyFn then pcall(liveApplyFn, parsed) end
	end)

	box.FocusLost:Connect(function()
		local parsed = parseHugeNum(box.Text, getVal(), minV)
		setVal(parsed)
		box.Text = tostring(parsed)
		if liveApplyFn then pcall(liveApplyFn, parsed)
		elseif getState() == true then setState(true, parsed) end
	end)
end

