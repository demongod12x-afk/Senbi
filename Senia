local EspFolder = Instance.new("Folder")
EspFolder.Name = "Senia_ESP"
EspFolder.Parent = workspace

local activeHighlights = {}

local function clearEspForPlayer(plr)
	local h = activeHighlights[plr]
	if h then
		pcall(function() h:Destroy() end)
		activeHighlights[plr] = nil
	end
end

local function updateEsp()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr == LocalPlayer then
			clearEspForPlayer(plr)
			continue
		end
		local char = plr.Character
		local shouldShow = false
		local col = Color3.fromRGB(255, 90, 90)

		if State.SelectedTarget == plr and State.EspTargetEnabled then
			shouldShow = true
			col = Color3.fromRGB(255, 200, 50)
		elseif State.FriendEsp[plr.UserId] then
			shouldShow = true
			col = Color3.fromRGB(80, 230, 140)
		elseif State.EspAllEnabled then
			shouldShow = true
			col = Color3.fromRGB(120, 175, 255)
		end

		if shouldShow and char and char.Parent then
			local hl = activeHighlights[plr]
			if not hl or hl.Parent ~= EspFolder then
				clearEspForPlayer(plr)
				hl = Instance.new("Highlight")
				hl.Name = "ESP_" .. plr.Name
				hl.Adornee = char
				hl.FillTransparency = 0.65
				hl.OutlineTransparency = 0
				hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				hl.Parent = EspFolder
				activeHighlights[plr] = hl
			end
			hl.Adornee = char
			hl.FillColor = col
			hl.OutlineColor = col
		else
			clearEspForPlayer(plr)
		end
	end
end

