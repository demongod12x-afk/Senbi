	friendsListFrame.LayoutOrder = 1
	friendsListFrame.Size = UDim2.new(0.96, 0, 0, 170)
	friendsListFrame.BackgroundTransparency = 1
	friendsListFrame.ZIndex = 33
	friendsListFrame.Parent = p2
	local fLay = Instance.new("UIListLayout", friendsListFrame)
	fLay.Padding = UDim.new(0, 4)
	fLay.HorizontalAlignment = Enum.HorizontalAlignment.Center
